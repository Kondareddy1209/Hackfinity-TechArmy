# ==============================================================================
# Agent Seller — Environment Configuration Template
# Copy this file to .env and replace placeholder values with your credentials.
# NEVER commit real credentials to version control.
# ==============================================================================

# Server Configuration
PORT=3000
NODE_ENV=development
APP_ID=agent-seller-app

# Database (MongoDB Connection String)
MONGO_URI=mongodb://localhost:27017/agent_seller
# For MongoDB Atlas:
# MONGO_URI=mongodb+srv://<username>:<password>@cluster0.example.mongodb.net/agent_seller?retryWrites=true&w=majority

# Authentication Security
JWT_SECRET=replace_with_a_secure_random_jwt_secret_string

# Google OAuth 2.0 (Client-side and Token Verification)
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com

# AI Services
# Google Gemini API Key (for product description generation)
GOOGLE_API_KEY=your_google_gemini_api_key

# Groq API Key (for Llama 3.1 conversational assistant)
GROQ_API_KEY=your_groq_api_key

# Firebase Client Configuration (Optional for client-side Firebase apps)
FIREBASE_API_KEY=your_firebase_web_api_key
FIREBASE_AUTH_DOMAIN=your-project-id.firebaseapp.com
FIREBASE_PROJECT_ID=your-project-id
FIREBASE_STORAGE_BUCKET=your-project-id.appspot.com
FIREBASE_MESSAGING_SENDER_ID=your_sender_id
FIREBASE_APP_ID=your_firebase_app_id
FIREBASE_MEASUREMENT_ID=your_measurement_id

# Firebase Admin SDK Configuration (for server-side Storage)
# Option A: Path to service account JSON file
FIREBASE_SERVICE_ACCOUNT_KEY_PATH=config/serviceAccountKey.json
# Option B: Stringified JSON content of the service account
# FIREBASE_SERVICE_ACCOUNT_JSON={"type":"service_account",...}

# Email Service (Nodemailer SMTP for OTPs and notifications)
EMAIL_USER=your_smtp_email@gmail.com
EMAIL_PASS=your_smtp_app_password
