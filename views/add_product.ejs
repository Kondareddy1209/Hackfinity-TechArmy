<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Admin - Add Product • MyGreenHome</title>
    <link rel="preconnect" href="https://cdn.tailwindcss.com">
    <link rel="dns-prefetch" href="https://cdn.tailwindcss.com">
    <link rel="preconnect" href="https://unpkg.com">
    <link rel="dns-prefetch" href="https://unpkg.com">
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="dns-prefetch" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link rel="dns-prefetch" href="https://fonts.gstatic.com">

    <script src="https://cdn.tailwindcss.com"></script>
    <script src="https://unpkg.com/lucide@latest"></script>
    <style>
        @import url('https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800&display=swap');

        body {
            font-family: 'Inter', -apple-system, BlinkMacSystemFont, 'Segoe UI', sans-serif;
            min-height: 100vh;
            background-color: #f0f2f5;
            background-attachment: fixed;
            display: flex;
            flex-direction: column;
            align-items: center;
        }

        .main-content-wrapper {
            flex-grow: 1;
            max-width: 800px;
            margin: 20px auto;
            padding: 25px;
            background: rgba(255, 255, 255, 0.95);
            backdrop-filter: blur(10px);
            border-radius: 20px;
            box-shadow: 0 25px 50px rgba(0, 0, 0, 0.15);
            width: 90%;
        }

        .section-title {
            text-align: center;
            font-size: 2.5rem;
            font-weight: 700;
            margin-bottom: 1.5rem;
            background: linear-gradient(135deg, #10b981 0%, #059669 100%);
            -webkit-background-clip: text;
            -webkit-text-fill-color: transparent;
            background-clip: text;
        }

        .tabs {
            display: flex;
            justify-content: center;
            margin-bottom: 1.5rem;
        }

        .tab-button {
            padding: 10px 20px;
            background-color: #e5e7eb;
            color: #4b5563;
            font-weight: 600;
            border: none;
            cursor: pointer;
            border-radius: 8px;
            margin: 0 5px;
            transition: all 0.2s ease;
        }

        .tab-button.active {
            background-color: #059669;
            color: white;
            box-shadow: 0 4px 10px rgba(5, 150, 105, 0.2);
        }

        .tab-button:hover:not(.active) {
            background-color: #d1d5db;
        }

        .tab-content {
            display: none;
        }

        .tab-content.active {
            display: block;
        }

        .form-group {
            margin-bottom: 1.5rem;
        }

        label {
            display: block;
            font-weight: 600;
            color: #374151;
            margin-bottom: 0.5rem;
        }

        input[type="text"],
        input[type="number"],
        input[type="url"],
        textarea,
        select,
        input[type="file"] {
            display: block;
            width: 100%;
            padding: 12px;
            border: 1px solid #d1d5db;
            border-radius: 8px;
            background-color: #f9fafb;
            transition: border-color 0.2s, box-shadow 0.2s;
            font-size: 1rem;
            color: #374151;
        }

        input[type="text"]:focus,
        input[type="number"]:focus,
        input[type="url"]:focus,
        textarea:focus,
        select:focus,
        input[type="file"]:focus {
            outline: none;
            border-color: #3b82f6;
            box-shadow: 0 0 0 3px rgba(59, 130, 246, 0.2);
        }

        textarea {
            min-height: 100px;
            resize: vertical;
        }

        .submit-button,
        .upload-button {
            display: inline-flex;
            align-items: center;
            justify-content: center;
            padding: 12px 24px;
            background: linear-gradient(135deg, #3b82f6 0%, #1d4ed8 100%);
            color: white;
            border: none;
            border-radius: 10px;
            font-weight: 600;
            cursor: pointer;
            transition: all 0.3s ease;
            box-shadow: 0 4px 15px rgba(0, 0, 0, 0.1);
            margin-right: 1rem; /* For spacing if multiple buttons */
        }

        .submit-button:hover,
        .upload-button:hover {
            transform: translateY(-2px);
            box-shadow: 0 8px 25px rgba(0, 0, 0, 0.2);
        }

        .status-message {
            margin-top: 1.5rem;
            padding: 15px;
            border-radius: 8px;
            font-weight: 500;
            text-align: center;
            display: none; /* Hidden by default */
        }

        .status-message.success {
            background-color: #d1fae5;
            color: #065f46;
            border: 1px solid #34d399;
        }

        .status-message.error {
            background-color: #fee2e2;
            color: #991b1b;
            border: 1px solid #ef4444;
        }

        .status-message.info {
            background-color: #e0f2fe;
            color: #1e40af;
            border: 1px solid #60a5fa;
        }

        .spinner {
            animation: spin 1s linear infinite;
        }

        @keyframes spin {
            0% {
                transform: rotate(0deg);
            }
            100% {
                transform: rotate(360deg);
            }
        }

        .icon {
            width: 20px;
            height: 20px;
            stroke: currentColor;
            fill: none;
            stroke-width: 2;
            margin-right: 8px;
        }
        
        .icon.no-margin { /* For icons that should not have right margin */
            margin-right: 0;
        }

        .back-link {
            display: inline-flex;
            align-items: center;
            gap: 8px;
            margin-top: 2rem;
            padding: 10px 20px;
            background: #6b7280;
            color: white;
            border-radius: 8px;
            font-weight: 600;
            text-decoration: none;
            transition: all 0.3s ease;
            box-shadow: 0 3px 10px rgba(0, 0, 0, 0.08);
        }

        .back-link:hover {
            transform: translateY(-1px);
            box-shadow: 0 6px 20px rgba(0, 0, 0, 0.15);
        }

        .flex-end {
            display: flex;
            justify-content: flex-end;
            margin-top: 1rem;
        }
    </style>
</head>

<body>
    <%- include('partials/navbar') %>

    <div class="main-content-wrapper">
        <h1 class="section-title">📦 Manage Products</h1>

        <div class="tabs">
            <button class="tab-button active" data-tab="single-product">Add Single Product</button>
            <button class="tab-button" data-tab="bulk-upload">Bulk Upload (Excel)</button>
        </div>

        <div id="single-product-tab" class="tab-content active">
            <h2 class="text-2xl font-bold text-gray-800 mb-6 text-center">Add New Product</h2>
            <form id="addProductForm" enctype="multipart/form-data">
                <div class="form-group">
                    <label for="name">Product Name:</label>
                    <input type="text" id="name" name="name" required>
                </div>
                <div class="form-group">
                    <label for="description">Description:</label>
                    <textarea id="description" name="description" required></textarea>
                </div>
                <div class="form-group">
                    <label for="price">Price ($):</label>
                    <input type="number" id="price" name="price" step="0.01" min="0" required>
                </div>
                <div class="form-group">
                    <label for="category">Category:</label>
                    <select id="category" name="category" required>
                        <option value="">Select Category</option>
                        <option value="Agriculture & Farming">🌱 Agriculture & Farming</option>
                        <option value="Arts & Handicrafts">🎨 Arts & Handicrafts</option>
                        <option value="Food & Groceries">🍎 Food & Groceries</option>
                        <option value="Retail & Fashion">🛍️ Retail & Fashion</option>
                        <option value="Technology">💻 Technology</option>
                        <option value="Home & Garden">🏡 Home & Garden</option>
                        <option value="Services">🛠️ Services</option>
                        <option value="Other">📦 Other</option>
                    </select>
                </div>
                <div class="form-group">
                    <label for="keywords">Keywords (comma-separated):</label>
                    <input type="text" id="keywords" name="keywords" placeholder="e.g., organic, handmade, sustainable">
                </div>
                <div class="form-group">
                    <label for="image">Product Image:</label>
                    <input type="file" id="image" name="image" accept="image/*">
                    <p class="text-sm text-gray-500 mt-1">Max 10MB. Leave blank if providing an Image URL.</p>
                </div>
                <div class="form-group">
                    <label for="imageUrl">Or Image URL:</label>
                    <input type="url" id="imageUrl" name="imageUrl" placeholder="http://example.com/image.jpg">
                    <p class="text-sm text-gray-500 mt-1">Image file will take precedence if both are provided.</p>
                </div>
                <button type="submit" class="submit-button">
                    <svg class="icon" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24">
                        <path d="M12 5v14M5 12h14" />
                    </svg>
                    Add Product
                </button>
            </form>
            <div id="singleProductStatus" class="status-message" style="display: none;"></div>
        </div>

        <div id="bulk-upload-tab" class="tab-content">
            <h2 class="text-2xl font-bold text-gray-800 mb-6 text-center">Bulk Upload Products via Excel</h2>
            <form id="excelUploadForm" enctype="multipart/form-data">
                <div class="form-group">
                    <label for="excelFile">Upload Product Excel Sheet (.xlsx, .xls)</label>
                    <input type="file" id="excelFile" name="excelFile" accept=".xlsx, .xls" required>
                    <p class="text-sm text-gray-500 mt-1">
                        Please ensure your Excel sheet has columns for: "Product Name", "Description", "Price", "Category", "Keywords" (optional), "Image URL" (optional).
                        "Product Name" will be used to identify and update existing products, otherwise new products will be created.
                    </p>
                </div>
                <button type="submit" class="upload-button">
                    <svg class="icon" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24">
                        <path d="M4 14.899A7 7 0 0 1 15.71 8h1.79a4.5 4.5 0 0 1 0 9H13M12 20V10M12 10l-4 4M12 10l4 4" />
                    </svg>
                    Upload Excel
                </button>
            </form>
            <div id="bulkUploadStatus" class="status-message" style="display: none;"></div>
        </div>

        <div class="flex-end">
            <a href="/admin_dashboard" class="back-link">
                <svg class="icon no-margin" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24">
                    <path d="m12 19-7-7 7-7" />
                    <path d="M19 12H5" />
                </svg>
                Back to Admin Dashboard
            </a>
        </div>
    </div>

    <%- include('partials/footer') %>

    <script>
        document.addEventListener('DOMContentLoaded', () => {
            // Tab functionality
            const tabButtons = document.querySelectorAll('.tab-button');
            const tabContents = document.querySelectorAll('.tab-content');

            tabButtons.forEach(button => {
                button.addEventListener('click', () => {
                    const targetTab = button.dataset.tab;

                    tabButtons.forEach(btn => btn.classList.remove('active'));
                    button.classList.add('active');

                    tabContents.forEach(content => {
                        if (content.id === `${targetTab}-tab`) {
                            content.classList.add('active');
                        } else {
                            content.classList.remove('active');
                        }
                    });
                });
            });

            // Single Product Add Form
            const addProductForm = document.getElementById('addProductForm');
            const singleProductStatus = document.getElementById('singleProductStatus');

            addProductForm.addEventListener('submit', async (event) => {
                event.preventDefault();

                displayStatus(singleProductStatus, 'info', '<svg class="icon spinner inline-block" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24"><path d="M21 12a9 9 0 1 1-6.219-8.56"/></svg> Adding product...');

                const formData = new FormData(addProductForm); // Collects all form data including files

                try {
                    const response = await fetch('/admin/products', { // This is your existing route
                        method: 'POST',
                        body: formData,
                    });

                    const result = await response.json();

                    if (response.ok) {
                        displayStatus(singleProductStatus, 'success', `✅ ${result.message}`);
                        addProductForm.reset(); // Clear the form
                    } else {
                        displayStatus(singleProductStatus, 'error', `❌ ${result.error || 'Failed to add product.'}`);
                    }
                } catch (error) {
                    console.error('Error adding product:', error);
                    displayStatus(singleProductStatus, 'error', '⛔ Network error. Failed to add product.');
                }
            });

            // Bulk Upload Form
            const excelUploadForm = document.getElementById('excelUploadForm');
            const bulkUploadStatus = document.getElementById('bulkUploadStatus');

            excelUploadForm.addEventListener('submit', async (event) => {
                event.preventDefault();

                const fileInput = document.getElementById('excelFile');
                const file = fileInput.files[0];

                if (!file) {
                    displayStatus(bulkUploadStatus, 'error', 'Please select an Excel file to upload.');
                    return;
                }

                if (!file.name.endsWith('.xlsx') && !file.name.endsWith('.xls')) {
                    displayStatus(bulkUploadStatus, 'error', 'Invalid file type. Please upload an .xlsx or .xls file.');
                    return;
                }

                displayStatus(bulkUploadStatus, 'info', '<svg class="icon spinner inline-block" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24"><path d="M21 12a9 9 0 1 1-6.219-8.56"/></svg> Uploading and processing...');

                const formData = new FormData();
                formData.append('excelFile', file);

                try {
                    const response = await fetch('/api/admin/products/bulk-upload', { // NEW API ENDPOINT
                        method: 'POST',
                        body: formData,
                    });

                    const result = await response.json();

                    if (response.ok) {
                        let successMessage = `✅ Upload successful! ${result.insertedCount || 0} products added, ${result.updatedCount || 0} products updated.`;
                        if (result.errors && result.errors.length > 0) {
                            successMessage += `<br><span style="color: #d97706;">⚠️ Some rows had issues:</span><ul>`;
                            result.errors.forEach(err => {
                                successMessage += `<li>Row: ${err.row_number || 'N/A'}: ${err.reason}</li>`;
                            });
                            successMessage += `</ul>`;
                            displayStatus(bulkUploadStatus, 'info', successMessage); // Use info for partial success
                        } else {
                            displayStatus(bulkUploadStatus, 'success', successMessage);
                        }
                        fileInput.value = ''; // Clear the file input
                    } else {
                        displayStatus(bulkUploadStatus, 'error', `❌ Upload failed: ${result.message || 'Unknown error'}. Details: ${result.details || 'N/A'}`);
                        console.error('Bulk upload error details:', result);
                    }
                } catch (error) {
                    console.error('Network or server error during bulk upload:', error);
                    displayStatus(bulkUploadStatus, 'error', '⛔ Network error or server is unreachable. Please try again.');
                }
            });

            // Helper function to display status messages
            function displayStatus(element, type, message) {
                element.style.display = 'block';
                element.className = `status-message ${type}`;
                element.innerHTML = message;
            }

            // Initialize Lucide icons
            lucide.createIcons();
        });
    </script>
</body>

</html>