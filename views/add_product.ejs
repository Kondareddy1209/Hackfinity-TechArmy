<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Admin - Add Product • MyGreenHome</title>
    <link rel="preconnect" href="https://cdn.tailwindcss.com">
    <link rel="dns-prefetch" href="https://cdn.tailwindcss.com">
    <link rel="preconnect" href="https://unpkg.com">
    <link rel="dns-prefetch" href="https://unpkg.com">
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="dns-prefetch" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link rel="dns-prefetch" href="https://fonts.gstatic.com">

    <script src="https://cdn.tailwindcss.com"></script>
    <script src="https://unpkg.com/lucide@latest"></script>
    <style>
        @import url('https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800&display=swap');

        :root {
            --primary-green: #10b981;
            --hover-green: #059669;
            --admin-blue: #3b82f6;
            --admin-blue-hover: #2563eb;
            --logout-red: #ef4444;
            --logout-red-hover: #dc2626;
            --dark-bg: #1f2937;
            --darker-bg: #111827;
            --page-bg: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
            --card-bg: rgba(255, 255, 255, 0.95);
            --card-border: #e5e7eb;
            --text-color: #1f2937;
            --navbar-text: #ffffff;
            --shadow-color: rgba(0, 0, 0, 0.1);
            --input-border: #d1d5db;
            --input-bg: #ffffff;
            --input-focus-border: #3b82f6;
            --input-focus-shadow: rgba(59, 130, 246, 0.1);
            --placeholder-color: #9ca3af;
            --hover-bg-light: #f3f4f6;
            --success-bg: #d1fae5;
            --success-border: #10b981;
            --error-bg: #fee2e2;
            --error-border: #ef4444;
            --warning-bg: #fef3c7;
            --warning-border: #f59e0b;
        }

        * {
            box-sizing: border-box;
        }

        body {
            font-family: 'Inter', -apple-system, BlinkMacSystemFont, 'Segoe UI', sans-serif;
            min-height: 100vh;
            background: var(--page-bg);
            background-attachment: fixed;
            margin: 0;
            padding: 0;
            color: var(--text-color);
            line-height: 1.6;
        }

        .container {
            max-width: 1200px;
            margin: 0 auto;
            padding: 2rem;
        }

        .header {
            text-align: center;
            margin-bottom: 3rem;
            position: relative;
        }

        .header::before {
            content: '';
            position: absolute;
            top: -20px;
            left: 50%;
            transform: translateX(-50%);
            width: 100px;
            height: 4px;
            background: linear-gradient(90deg, var(--primary-green), var(--admin-blue));
            border-radius: 2px;
        }

        .main-title {
            font-size: 3rem;
            font-weight: 800;
            margin-bottom: 0.5rem;
            background: linear-gradient(135deg, var(--primary-green) 0%, var(--admin-blue) 100%);
            -webkit-background-clip: text;
            -webkit-text-fill-color: transparent;
            background-clip: text;
            text-shadow: 0 4px 8px rgba(0,0,0,0.1);
        }

        .subtitle {
            font-size: 1.125rem;
            color: #64748b;
            font-weight: 500;
        }

        .card {
            background: var(--card-bg);
            backdrop-filter: blur(20px);
            border-radius: 24px;
            box-shadow: 0 32px 64px rgba(0, 0, 0, 0.12);
            border: 1px solid rgba(255, 255, 255, 0.2);
            overflow: hidden;
            transition: all 0.3s ease;
        }

        .card:hover {
            transform: translateY(-4px);
            box-shadow: 0 40px 80px rgba(0, 0, 0, 0.16);
        }

        .tabs-container {
            padding: 2rem 2rem 0 2rem;
        }

        .tabs {
            display: flex;
            background: #f8fafc;
            border-radius: 16px;
            padding: 4px;
            margin-bottom: 2rem;
            box-shadow: inset 0 2px 4px rgba(0, 0, 0, 0.06);
        }

        .tab-button {
            flex: 1;
            padding: 16px 24px;
            background: transparent;
            color: #64748b;
            font-weight: 600;
            border: none;
            cursor: pointer;
            border-radius: 12px;
            transition: all 0.3s ease;
            display: flex;
            align-items: center;
            justify-content: center;
            gap: 8px;
            font-size: 0.95rem;
            position: relative;
        }

        .tab-button.active {
            background: linear-gradient(135deg, var(--primary-green), var(--hover-green));
            color: white;
            box-shadow: 0 8px 24px rgba(16, 185, 129, 0.3);
            transform: translateY(-1px);
        }

        .tab-button:hover:not(.active) {
            background: rgba(59, 130, 246, 0.1);
            color: var(--admin-blue);
        }

        .tab-content {
            display: none;
            padding: 0 2rem 2rem 2rem;
            animation: fadeIn 0.3s ease-in-out;
        }

        .tab-content.active {
            display: block;
        }

        @keyframes fadeIn {
            from { opacity: 0; transform: translateY(10px); }
            to { opacity: 1; transform: translateY(0); }
        }

        .section-header {
            text-align: center;
            margin-bottom: 2rem;
        }

        .section-title {
            font-size: 1.875rem;
            font-weight: 700;
            color: var(--text-color);
            margin-bottom: 0.5rem;
        }

        .section-description {
            color: #64748b;
            font-size: 1rem;
        }

        .form-grid {
            display: grid;
            gap: 1.5rem;
            margin-bottom: 2rem;
        }

        .form-grid.two-column {
            grid-template-columns: 1fr 1fr;
        }

        .form-group {
            position: relative;
        }

        .form-group.full-width {
            grid-column: 1 / -1;
        }

        label {
            display: block;
            font-weight: 600;
            color: var(--text-color);
            margin-bottom: 8px;
            font-size: 0.875rem;
            text-transform: uppercase;
            letter-spacing: 0.5px;
        }

        .input-wrapper {
            position: relative;
        }

        input[type="text"],
        input[type="number"],
        input[type="url"],
        textarea,
        select {
            width: 100%;
            padding: 16px 20px;
            border: 2px solid var(--input-border);
            border-radius: 12px;
            background: var(--input-bg);
            transition: all 0.3s ease;
            font-size: 1rem;
            color: var(--text-color);
            font-family: inherit;
        }

        input[type="text"]:focus,
        input[type="number"]:focus,
        input[type="url"]:focus,
        textarea:focus,
        select:focus {
            outline: none;
            border-color: var(--admin-blue);
            box-shadow: 0 0 0 4px var(--input-focus-shadow);
            transform: translateY(-1px);
        }

        input::placeholder,
        textarea::placeholder {
            color: var(--placeholder-color);
        }

        textarea {
            min-height: 120px;
            resize: vertical;
            font-family: inherit;
        }

        .file-upload-area {
            border: 2px dashed var(--input-border);
            border-radius: 16px;
            padding: 2rem;
            text-align: center;
            background: linear-gradient(45deg, #f8fafc 0%, #f1f5f9 100%);
            transition: all 0.3s ease;
            cursor: pointer;
            position: relative;
            overflow: hidden;
        }

        .file-upload-area:hover {
            border-color: var(--admin-blue);
            background: linear-gradient(45deg, #eff6ff 0%, #dbeafe 100%);
        }

        .file-upload-area.dragover {
            border-color: var(--primary-green);
            background: linear-gradient(45deg, #ecfdf5 0%, #d1fae5 100%);
            transform: scale(1.02);
        }

        .file-upload-content {
            display: flex;
            flex-direction: column;
            align-items: center;
            gap: 1rem;
        }

        .upload-icon {
            width: 48px;
            height: 48px;
            color: var(--admin-blue);
            opacity: 0.7;
        }

        .file-input {
            position: absolute;
            top: 0;
            left: 0;
            width: 100%;
            height: 100%;
            opacity: 0;
            cursor: pointer;
        }

        .file-info {
            margin-top: 1rem;
            padding: 1rem;
            background: rgba(59, 130, 246, 0.1);
            border-radius: 8px;
            color: var(--admin-blue);
            font-size: 0.875rem;
            display: none;
        }

        .button-group {
            display: flex;
            gap: 1rem;
            justify-content: flex-end;
            align-items: center;
            margin-top: 2rem;
            padding-top: 2rem;
            border-top: 1px solid var(--card-border);
        }

        .btn {
            display: inline-flex;
            align-items: center;
            justify-content: center;
            gap: 8px;
            padding: 16px 32px;
            border: none;
            border-radius: 12px;
            font-weight: 600;
            cursor: pointer;
            transition: all 0.3s ease;
            font-size: 1rem;
            text-decoration: none;
            position: relative;
            overflow: hidden;
        }

        .btn::before {
            content: '';
            position: absolute;
            top: 0;
            left: -100%;
            width: 100%;
            height: 100%;
            background: linear-gradient(90deg, transparent, rgba(255,255,255,0.2), transparent);
            transition: left 0.5s;
        }

        .btn:hover::before {
            left: 100%;
        }

        .btn-primary {
            background: linear-gradient(135deg, var(--admin-blue), var(--admin-blue-hover));
            color: white;
            box-shadow: 0 8px 24px rgba(59, 130, 246, 0.3);
        }

        .btn-primary:hover {
            transform: translateY(-2px);
            box-shadow: 0 12px 32px rgba(59, 130, 246, 0.4);
        }

        .btn-success {
            background: linear-gradient(135deg, var(--primary-green), var(--hover-green));
            color: white;
            box-shadow: 0 8px 24px rgba(16, 185, 129, 0.3);
        }

        .btn-success:hover {
            transform: translateY(-2px);
            box-shadow: 0 12px 32px rgba(16, 185, 129, 0.4);
        }

        .btn-secondary {
            background: var(--dark-bg);
            color: white;
            box-shadow: 0 8px 24px rgba(31, 41, 55, 0.3);
        }

        .btn-secondary:hover {
            background: var(--darker-bg);
            transform: translateY(-2px);
            box-shadow: 0 12px 32px rgba(31, 41, 55, 0.4);
        }

        .status-message {
            margin-top: 2rem;
            padding: 20px;
            border-radius: 12px;
            font-weight: 500;
            display: none;
            position: relative;
            overflow: hidden;
            animation: slideIn 0.3s ease-out;
        }

        @keyframes slideIn {
            from { transform: translateY(-10px); opacity: 0; }
            to { transform: translateY(0); opacity: 1; }
        }

        .status-message::before {
            content: '';
            position: absolute;
            top: 0;
            left: 0;
            width: 4px;
            height: 100%;
        }

        .status-message.success {
            background: var(--success-bg);
            color: var(--success-border);
            border: 1px solid rgba(16, 185, 129, 0.2);
        }

        .status-message.success::before {
            background: var(--success-border);
        }

        .status-message.error {
            background: var(--error-bg);
            color: var(--error-border);
            border: 1px solid rgba(239, 68, 68, 0.2);
        }

        .status-message.error::before {
            background: var(--error-border);
        }

        .status-message.info {
            background: rgba(59, 130, 246, 0.1);
            color: var(--admin-blue);
            border: 1px solid rgba(59, 130, 246, 0.2);
        }

        .status-message.info::before {
            background: var(--admin-blue);
        }

        .spinner {
            animation: spin 1s linear infinite;
        }

        @keyframes spin {
            0% { transform: rotate(0deg); }
            100% { transform: rotate(360deg); }
        }

        .icon {
            width: 20px;
            height: 20px;
            stroke: currentColor;
            fill: none;
            stroke-width: 2;
        }

        .back-link {
            position: fixed;
            top: 2rem;
            left: 2rem;
            display: inline-flex;
            align-items: center;
            gap: 8px;
            padding: 12px 20px;
            background: rgba(31, 41, 55, 0.9);
            color: white;
            border-radius: 12px;
            font-weight: 600;
            text-decoration: none;
            transition: all 0.3s ease;
            backdrop-filter: blur(10px);
            z-index: 100;
        }

        .back-link:hover {
            transform: translateX(-4px);
            background: rgba(17, 24, 39, 0.9);
        }

        .template-link {
            display: inline-flex;
            align-items: center;
            gap: 8px;
            color: var(--admin-blue);
            text-decoration: none;
            font-weight: 500;
            font-size: 0.875rem;
            margin-top: 1rem;
            padding: 8px 16px;
            border-radius: 8px;
            background: rgba(59, 130, 246, 0.1);
            transition: all 0.3s ease;
        }

        .template-link:hover {
            background: rgba(59, 130, 246, 0.2);
            transform: translateY(-1px);
        }

        .progress-bar {
            width: 100%;
            height: 4px;
            background: #e5e7eb;
            border-radius: 2px;
            overflow: hidden;
            margin-top: 1rem;
            display: none;
        }

        .progress-fill {
            height: 100%;
            background: linear-gradient(90deg, var(--primary-green), var(--admin-blue));
            border-radius: 2px;
            transition: width 0.3s ease;
            width: 0%;
        }

        /* Responsive Design */
        @media (max-width: 768px) {
            .container {
                padding: 1rem;
            }

            .main-title {
                font-size: 2rem;
            }

            .form-grid.two-column {
                grid-template-columns: 1fr;
            }

            .tabs {
                flex-direction: column;
            }

            .tab-button {
                justify-content: flex-start;
            }

            .button-group {
                flex-direction: column;
                align-items: stretch;
            }

            .btn {
                justify-content: center;
            }

            .back-link {
                position: relative;
                top: auto;
                left: auto;
                margin-bottom: 2rem;
                align-self: flex-start;
            }

            .file-upload-area {
                padding: 1.5rem;
            }
        }

        /* Dark mode support */
        @media (prefers-color-scheme: dark) {
            :root {
                --page-bg: linear-gradient(135deg, #1e293b 0%, #0f172a 100%);
                --card-bg: rgba(30, 41, 59, 0.95);
                --text-color: #f1f5f9;
                --input-bg: #334155;
                --input-border: #475569;
                --card-border: #475569;
                --placeholder-color: #94a3b8;
            }
        }
    </style>
</head>

<body>
    <%- include('partials/navbar') %>
    
    <a href="/user_dashboard" class="back-link">
        <svg class="icon" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24">
            <path d="m12 19-7-7 7-7" />
            <path d="M19 12H5" />
        </svg>
        Back to Dashboard
    </a>

    <div class="container">
        <div class="header">
            <h1 class="main-title">📦 Product Management</h1>
            <p class="subtitle">Add new products or upload in bulk to expand your catalog</p>
        </div>

        <div class="card">
            <div class="tabs-container">
                <div class="tabs">
                    <button class="tab-button active" data-tab="single-product">
                        <svg class="icon" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24">
                            <path d="M12 5v14M5 12h14" />
                        </svg>
                        Add Single Product
                    </button>
                    <button class="tab-button" data-tab="bulk-upload">
                        <svg class="icon" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24">
                            <path d="M4 14.899A7 7 0 0 1 15.71 8h1.79a4.5 4.5 0 0 1 0 9H13M12 20V10M12 10l-4 4M12 10l4 4" />
                        </svg>
                        Bulk Upload
                    </button>
                </div>
            </div>

            <div id="single-product-tab" class="tab-content active">
                <div class="section-header">
                    <h2 class="section-title">Create New Product</h2>
                    <p class="section-description">Fill out the form below to add a new product to your catalog</p>
                </div>

                <form id="addProductForm" enctype="multipart/form-data">
                    <div class="form-grid two-column">
                        <div class="form-group">
                            <label for="name">Product Name</label>
                            <input type="text" id="name" name="name" placeholder="e.g., Organic Cotton T-Shirt" required>
                        </div>
                        <div class="form-group">
                            <label for="price">Price ($)</label>
                            <input type="number" id="price" name="price" step="0.01" min="0" placeholder="29.99" required>
                        </div>
                        <div class="form-group full-width">
                            <label for="description">Description</label>
                            <textarea id="description" name="description" placeholder="Describe your product features, benefits, and what makes it special..." required></textarea>
                        </div>
                        <div class="form-group">
                            <label for="category">Category</label>
                            <select id="category" name="category" required>
                                <option value="">Select Category</option>
                                <option value="Agriculture & Farming">🌱 Agriculture & Farming</option>
                                <option value="Arts & Handicrafts">🎨 Arts & Handicrafts</option>
                                <option value="Food & Groceries">🍎 Food & Groceries</option>
                                <option value="Retail & Fashion">🛍️ Retail & Fashion</option>
                                <option value="Technology">💻 Technology</option>
                                <option value="Home & Garden">🏡 Home & Garden</option>
                                <option value="Services">🛠️ Services</option>
                                <option value="Other">📦 Other</option>
                            </select>
                        </div>
                        <div class="form-group">
                            <label for="keywords">Keywords</label>
                            <input type="text" id="keywords" name="keywords" placeholder="organic, sustainable, handmade">
                        </div>
                        <div class="form-group full-width">
                            <label for="image">Product Image</label>
                            <div class="file-upload-area" id="imageUploadArea">
                                <div class="file-upload-content">
                                    <svg class="upload-icon" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24">
                                        <path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4M17 8l-5-5-5 5M12 3v12" />
                                    </svg>
                                    <div>
                                        <strong>Click to upload</strong> or drag and drop
                                    </div>
                                    <div style="font-size: 0.875rem; color: #64748b;">
                                        PNG, JPG, GIF up to 10MB
                                    </div>
                                </div>
                                <input type="file" id="image" name="image" accept="image/*" class="file-input">
                            </div>
                            <div id="imageInfo" class="file-info"></div>
                        </div>
                        <div class="form-group full-width">
                            <label for="imageUrl">Or Image URL</label>
                            <input type="url" id="imageUrl" name="imageUrl" placeholder="https://example.com/image.jpg">
                            <p style="font-size: 0.75rem; color: #64748b; margin-top: 0.5rem;">
                                File upload takes precedence over URL if both are provided.
                            </p>
                        </div>
                    </div>

                    <div class="button-group">
                        <button type="submit" class="btn btn-success">
                            <svg class="icon" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24">
                                <path d="M12 5v14M5 12h14" />
                            </svg>
                            Add Product
                        </button>
                    </div>
                </form>

                <div id="singleProductStatus" class="status-message"></div>
            </div>

            <div id="bulk-upload-tab" class="tab-content">
                <div class="section-header">
                    <h2 class="section-title">Bulk Upload Products</h2>
                    <p class="section-description">Upload multiple products at once using an Excel spreadsheet</p>
                </div>

                <form id="excelUploadForm" enctype="multipart/form-data">
                    <div class="form-grid">
                        <div class="form-group full-width">
                            <label for="excelFile">Excel File (.xlsx, .xls)</label>
                            <div class="file-upload-area" id="excelUploadArea">
                                <div class="file-upload-content">
                                    <svg class="upload-icon" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24">
                                        <path d="M14.5 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V7.5L14.5 2z" />
                                        <polyline points="14,2 14,8 20,8" />
                                    </svg>
                                    <div>
                                        <strong>Click to upload Excel file</strong> or drag and drop
                                    </div>
                                    <div style="font-size: 0.875rem; color: #64748b;">
                                        Excel files (.xlsx, .xls) only
                                    </div>
                                </div>
                                <input type="file" id="excelFile" name="excelFile" accept=".xlsx,.xls" class="file-input" required>
                            </div>
                            <div id="excelInfo" class="file-info"></div>
                            <div class="progress-bar" id="uploadProgress">
                                <div class="progress-fill" id="progressFill"></div>
                            </div>
                            <a href="/download-template" class="template-link">
                                <svg class="icon" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24">
                                    <path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4M7 10l5 5 5-5M12 15V3" />
                                </svg>
                                Download Excel Template
                            </a>
                            <p style="font-size: 0.875rem; color: #64748b; margin-top: 1rem; line-height: 1.5;">
                                <strong>Required columns:</strong> Product Name, Description, Price, Category<br>
                                <strong>Optional columns:</strong> Keywords, Image URL<br>
                                Products with existing names will be updated, otherwise new products will be created.
                            </p>
                        </div>
                    </div>

                    <div class="button-group">
                        <button type="submit" class="btn btn-primary">
                            <svg class="icon" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24">
                                <path d="M4 14.899A7 7 0 0 1 15.71 8h1.79a4.5 4.5 0 0 1 0 9H13M12 20V10M12 10l-4 4M12 10l4 4" />
                            </svg>
                            Upload Excel
                        </button>
                    </div>
                </form>

                <div id="bulkUploadStatus" class="status-message"></div>
            </div>
        </div>
    </div>

    <%- include('partials/footer') %>

    <script>
        document.addEventListener('DOMContentLoaded', () => {
            // Tab functionality
            const tabButtons = document.querySelectorAll('.tab-button');
            const tabContents = document.querySelectorAll('.tab-content');

            tabButtons.forEach(button => {
                button.addEventListener('click', () => {
                    const targetTab = button.dataset.tab;

                    tabButtons.forEach(btn => btn.classList.remove('active'));
                    button.classList.add('active');

                    tabContents.forEach(content => {
                        if (content.id === `${targetTab}-tab`) {
                            content.classList.add('active');
                        } else {
                            content.classList.remove('active');
                        }
                    });
                });
            });

            // File upload functionality
            setupFileUpload('imageUploadArea', 'image', 'imageInfo');
            setupFileUpload('excelUploadArea', 'excelFile', 'excelInfo');

            function setupFileUpload(areaId, inputId, infoId) {
                const uploadArea = document.getElementById(areaId);
                const fileInput = document.getElementById(inputId);
                const fileInfo = document.getElementById(infoId);

                uploadArea.addEventListener('dragover', (e) => {
                    e.preventDefault();
                    uploadArea.classList.add('dragover');
                });

                uploadArea.addEventListener('dragleave', () => {
                    uploadArea.classList.remove('dragover');
                });

                uploadArea.addEventListener('drop', (e) => {
                    e.preventDefault();
                    uploadArea.classList.remove('dragover');
                    const files = e.dataTransfer.files;
                    if (files.length > 0) {
                        fileInput.files = files;
                        showFileInfo(files[0], fileInfo);
                    }
                });

                fileInput.addEventListener('change', (e) => {
                    if (e.target.files.length > 0) {
                        showFileInfo(e.target.files[0], fileInfo);
                    }
                });
            }

            function showFileInfo(file, infoElement) {
                const fileSize = (file.size / (1024 * 1024)).toFixed(2);
                infoElement.innerHTML = `
                    <div style="display: flex; align-items: center; gap: 8px;">
                        <svg class="icon" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24">
                            <path d="M14.5 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V7.5L14.5 2z"/>
                            <polyline points="14,2 14,8 20,8"/>
                        </svg>
                        <div>
                            <strong>${file.name}</strong><br>
                            <span style="font-size: 0.75rem; opacity: 0.8;">${file.type} • ${fileSize} MB</span>
                        </div>
                    </div>
                `;
                infoElement.style.display = 'block';
            }

            // Single Product Add Form
            const addProductForm = document.getElementById('addProductForm');
            const singleProductStatus = document.getElementById('singleProductStatus');

            addProductForm.addEventListener('submit', async (event) => {
                event.preventDefault();

                displayStatus(singleProductStatus, 'info', `
                    <div style="display: flex; align-items: center; gap: 8px;">
                        <svg class="icon spinner" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24">
                            <path d="M21 12a9 9 0 1 1-6.219-8.56"/>
                        </svg>
                        Adding product...
                    </div>
                `);

                const formData = new FormData(addProductForm);

                try {
                    const response = await fetch('/admin/products', {
                        method: 'POST',
                        body: formData,
                    });

                    const result = await response.json();

                    if (response.ok) {
                        displayStatus(singleProductStatus, 'success', `
                            <div style="display: flex; align-items: center; gap: 8px;">
                                <svg class="icon" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24">
                                    <path d="M20 6L9 17l-5-5"/>
                                </svg>
                                ${result.message || 'Product added successfully!'}
                            </div>
                        `);
                        addProductForm.reset();
                        document.getElementById('imageInfo').style.display = 'none';
                    } else {
                        displayStatus(singleProductStatus, 'error', `
                            <div style="display: flex; align-items: center; gap: 8px;">
                                <svg class="icon" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24">
                                    <circle cx="12" cy="12" r="10"/>
                                    <line x1="15" y1="9" x2="9" y2="15"/>
                                    <line x1="9" y1="9" x2="15" y2="15"/>
                                </svg>
                                ${result.error || 'Failed to add product.'}
                            </div>
                        `);
                    }
                } catch (error) {
                    console.error('Error adding product:', error);
                    displayStatus(singleProductStatus, 'error', `
                        <div style="display: flex; align-items: center; gap: 8px;">
                            <svg class="icon" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24">
                                <circle cx="12" cy="12" r="10"/>
                                <line x1="12" y1="8" x2="12" y2="12"/>
                                <line x1="12" y1="16" x2="12.01" y2="16"/>
                            </svg>
                            Network error. Failed to add product.
                        </div>
                    `);
                }
            });

            // Bulk Upload Form
            const excelUploadForm = document.getElementById('excelUploadForm');
            const bulkUploadStatus = document.getElementById('bulkUploadStatus');
            const uploadProgress = document.getElementById('uploadProgress');
            const progressFill = document.getElementById('progressFill');

            excelUploadForm.addEventListener('submit', async (event) => {
                event.preventDefault();

                const fileInput = document.getElementById('excelFile');
                const file = fileInput.files[0];

                if (!file) {
                    displayStatus(bulkUploadStatus, 'error', `
                        <div style="display: flex; align-items: center; gap: 8px;">
                            <svg class="icon" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24">
                                <circle cx="12" cy="12" r="10"/>
                                <line x1="15" y1="9" x2="9" y2="15"/>
                                <line x1="9" y1="9" x2="15" y2="15"/>
                            </svg>
                            Please select an Excel file to upload.
                        </div>
                    `);
                    return;
                }

                if (!file.name.endsWith('.xlsx') && !file.name.endsWith('.xls')) {
                    displayStatus(bulkUploadStatus, 'error', `
                        <div style="display: flex; align-items: center; gap: 8px;">
                            <svg class="icon" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24">
                                <circle cx="12" cy="12" r="10"/>
                                <line x1="15" y1="9" x2="9" y2="15"/>
                                <line x1="9" y1="9" x2="15" y2="15"/>
                            </svg>
                            Invalid file type. Please upload an .xlsx or .xls file.
                        </div>
                    `);
                    return;
                }

                // Show progress bar
                uploadProgress.style.display = 'block';
                progressFill.style.width = '0%';

                displayStatus(bulkUploadStatus, 'info', `
                    <div style="display: flex; align-items: center; gap: 8px;">
                        <svg class="icon spinner" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24">
                            <path d="M21 12a9 9 0 1 1-6.219-8.56"/>
                        </svg>
                        Uploading and processing Excel file...
                    </div>
                `);

                // Simulate progress
                let progress = 0;
                const progressInterval = setInterval(() => {
                    progress += Math.random() * 15;
                    if (progress > 90) progress = 90;
                    progressFill.style.width = progress + '%';
                }, 200);

                const formData = new FormData();
                formData.append('excelFile', file);

                try {
                    const response = await fetch('/api/admin/products/bulk-upload', {
                        method: 'POST',
                        body: formData,
                    });

                    clearInterval(progressInterval);
                    progressFill.style.width = '100%';

                    const result = await response.json();
                    
                    setTimeout(() => {
                        uploadProgress.style.display = 'none';
                        progressFill.style.width = '0%';
                    }, 1000);

                    if (response.ok) {
                        let successMessage = `
                            <div style="display: flex; align-items: center; gap: 8px; margin-bottom: 1rem;">
                                <svg class="icon" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24">
                                    <path d="M20 6L9 17l-5-5"/>
                                </svg>
                                Upload successful!
                            </div>
                            <div style="background: rgba(255,255,255,0.1); padding: 1rem; border-radius: 8px; margin-top: 1rem;">
                                <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 1rem; font-size: 0.875rem;">
                                    <div>✅ Products added: <strong>${result.insertedCount || 0}</strong></div>
                                    <div>🔄 Products updated: <strong>${result.updatedCount || 0}</strong></div>
                                </div>
                            </div>
                        `;
                        
                        if (result.errors && result.errors.length > 0) {
                            successMessage += `
                                <div style="margin-top: 1rem; padding: 1rem; background: rgba(245, 158, 11, 0.1); border-radius: 8px; border-left: 4px solid #f59e0b;">
                                    <div style="font-weight: 600; margin-bottom: 0.5rem; color: #f59e0b;">⚠️ Some rows had issues:</div>
                                    <ul style="margin: 0; padding-left: 1rem; font-size: 0.875rem;">
                            `;
                            result.errors.forEach(err => {
                                successMessage += `<li>Row ${err.row_number || 'N/A'}: ${err.reason}</li>`;
                            });
                            successMessage += `</ul></div>`;
                            displayStatus(bulkUploadStatus, 'info', successMessage);
                        } else {
                            displayStatus(bulkUploadStatus, 'success', successMessage);
                        }
                        fileInput.value = '';
                        document.getElementById('excelInfo').style.display = 'none';
                    } else {
                        displayStatus(bulkUploadStatus, 'error', `
                            <div style="display: flex; align-items: center; gap: 8px;">
                                <svg class="icon" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24">
                                    <circle cx="12" cy="12" r="10"/>
                                    <line x1="15" y1="9" x2="9" y2="15"/>
                                    <line x1="9" y1="9" x2="15" y2="15"/>
                                </svg>
                                Upload failed: ${result.message || 'Unknown error'}
                            </div>
                            ${result.details ? `<div style="margin-top: 0.5rem; font-size: 0.875rem; opacity: 0.8;">Details: ${result.details}</div>` : ''}
                        `);
                        console.error('Bulk upload error details:', result);
                    }
                } catch (error) {
                    clearInterval(progressInterval);
                    uploadProgress.style.display = 'none';
                    progressFill.style.width = '0%';
                    
                    console.error('Network or server error during bulk upload:', error);
                    displayStatus(bulkUploadStatus, 'error', `
                        <div style="display: flex; align-items: center; gap: 8px;">
                            <svg class="icon" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24">
                                <circle cx="12" cy="12" r="10"/>
                                <line x1="12" y1="8" x2="12" y2="12"/>
                                <line x1="12" y1="16" x2="12.01" y2="16"/>
                            </svg>
                            Network error or server is unreachable. Please try again.
                        </div>
                    `);
                }
            });

            // Helper function to display status messages
            function displayStatus(element, type, message) {
                element.style.display = 'block';
                element.className = `status-message ${type}`;
                element.innerHTML = message;
                
                // Auto-hide success messages after 5 seconds
                if (type === 'success') {
                    setTimeout(() => {
                        element.style.display = 'none';
                    }, 5000);
                }
            }

            // Initialize Lucide icons
            lucide.createIcons();
        });
    </script>
</body>

</html>