<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Add Product Listing • Agent Seller</title>
    <script src="https://cdn.tailwindcss.com"></script>
    <script src="https://unpkg.com/lucide@latest"></script>
    <style>
        /* Your original CSS styles (including original button sizes) */
        * {
            box-sizing: border-box;
        }

        body {
            font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, Oxygen, Ubuntu, Cantarell, sans-serif;
            line-height: 1.6;
        }

        /* Enhanced form styling with reduced container */
        .form-container {
            background: linear-gradient(135deg, #f8fafc 0%, #e2e8f0 100%);
            border: 1px solid #e2e8f0;
            backdrop-filter: blur(10px);
        }

        .form-input {
            transition: all 0.3s ease;
            border: 2px solid #e2e8f0;
            background: rgba(255, 255, 255, 0.9);
        }

        .form-input:focus {
            border-color: #22c55e;
            box-shadow: 0 0 0 3px rgba(34, 197, 94, 0.1);
            background: #ffffff;
            transform: translateY(-1px);
        }

        /* Button animations */
        .btn {
            transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
            position: relative;
            overflow: hidden;
            /* Reverted original button sizes */
            padding: 16px; 
            font-size: 1rem; 
        }

        .btn:before {
            content: '';
            position: absolute;
            top: 0;
            left: -100%;
            width: 100%;
            height: 100%;
            background: linear-gradient(90deg, transparent, rgba(255,255,255,0.2), transparent);
            transition: left 0.5s;
        }

        .btn:hover:before {
            left: 100%;
        }

        .btn-primary {
            background: linear-gradient(135deg, #22c55e 0%, #16a34a 100%);
            box-shadow: 0 4px 15px rgba(34, 197, 94, 0.3);
        }

        .btn-primary:hover {
            transform: translateY(-2px);
            box-shadow: 0 8px 25px rgba(34, 197, 94, 0.4);
        }

        .btn-secondary {
            background: linear-gradient(135deg, #6b7280 0%, #4b5563 100%);
            box-shadow: 0 4px 15px rgba(107, 114, 128, 0.3);
        }

        .btn-secondary:hover {
            transform: translateY(-2px);
            box-shadow: 0 8px 25px rgba(107, 114, 128, 0.4);
        }

        /* Voice input styling */
        .mic-button {
            /* Reverted mic button size */
            width: 48px; 
            height: 48px; 
            border-radius: 12px;
            background: linear-gradient(135deg, #3b82f6 0%, #2563eb 100%);
            transition: all 0.3s ease;
            box-shadow: 0 2px 8px rgba(59, 130, 246, 0.3);
        }

        .mic-button:hover:not(:disabled) {
            transform: scale(1.05);
            box-shadow: 0 4px 15px rgba(59, 130, 246, 0.4);
        }

        .mic-button.recording {
            background: linear-gradient(135deg, #ef4444 0%, #dc2626 100%);
            animation: pulse-glow 1.5s infinite;
        }

        @keyframes pulse-glow {

            0%,
            100% {
                box-shadow: 0 0 0 0 rgba(239, 68, 68, 0.7);
                transform: scale(1);
            }

            50% {
                box-shadow: 0 0 0 10px rgba(239, 68, 68, 0);
                transform: scale(1.05);
            }
        }

        /* Message styling */
        .message {
            border-radius: 12px;
            padding: 16px;
            margin-bottom: 24px;
            font-weight: 500;
            text-align: center;
            animation: slideIn 0.3s ease-out;
        }

        @keyframes slideIn {
            from {
                opacity: 0;
                transform: translateY(-10px);
            }

            to {
                opacity: 1;
                transform: translateY(0);
            }
        }

        /* File upload styling */
        .file-upload-area {
            border: 2px dashed #e2e8f0;
            border-radius: 12px;
            padding: 24px;
            text-align: center;
            transition: all 0.3s ease;
            background: rgba(255, 255, 255, 0.9);
            cursor: pointer;
        }

        .file-upload-area:hover {
            border-color: #22c55e;
            background: rgba(34, 197, 94, 0.05);
        }

        .file-upload-area.dragover {
            border-color: #22c55e;
            background: rgba(34, 197, 94, 0.1);
            transform: scale(1.02);
        }

        .file-preview {
            margin-top: 16px;
            padding: 12px;
            border: 1px solid #e2e8f0;
            border-radius: 8px;
            background: rgba(255, 255, 255, 0.95);
        }

        .file-preview img {
            max-width: 200px;
            max-height: 200px;
            object-fit: cover;
            border-radius: 8px;
        }

        /* Mobile optimizations */
        @media (max-width: 768px) {
            .form-container {
                margin: 16px 12px;
                padding: 20px 16px;
                border-radius: 16px;
            }

            .input-with-mic {
                flex-direction: column;
                gap: 12px;
            }

            .input-with-mic input,
            .input-with-mic textarea {
                width: 100%;
            }

            .mic-button {
                align-self: flex-end;
                width: 48px;
                height: 48px;
            }

            .form-buttons {
                flex-direction: column-reverse;
                gap: 12px;
            }

            .btn {
                width: 100%;
                justify-content: center;
            }

            h2 {
                font-size: 1.75rem;
                line-height: 2rem;
            }
        }

        /* Loading state */
        .loading {
            opacity: 0.7;
            pointer-events: none;
        }

        .loading .btn {
            position: relative;
        }

        .loading .btn::after {
            content: '';
            position: absolute;
            width: 16px;
            height: 16px;
            margin: auto;
            border: 2px solid transparent;
            border-top-color: #ffffff;
            border-radius: 50%;
            animation: spin 1s linear infinite;
        }

        @keyframes spin {
            0% { transform: rotate(0deg); }
            100% { transform: rotate(360deg); }
        }

        /* Enhanced focus visibility */
        .form-input:focus,
        .btn:focus,
        .mic-button:focus {
            outline: 2px solid #22c55e;
            outline-offset: 2px;
        }
    </style>
</head>

<body>
        <%- include('partials/navbar') %>

    <div class="container mx-auto px-4 py-6">
        <div class="form-container max-w-2xl mx-auto rounded-xl shadow-lg p-6">
                        <div class="text-center mb-6">
                <div class="inline-flex items-center justify-center w-12 h-12 bg-green-100 rounded-full mb-3">
                    <i data-lucide="plus-circle" class="w-6 h-6 text-green-600"></i>
                </div>
                <h2 class="text-2xl md:text-3xl font-bold text-gray-800 mb-2">Add New Product Listing</h2>
                <p class="text-gray-600">Share your products with our community</p>
            </div>

                        <div id="messageContainer"></div>

                        <form id="addListingForm" class="space-y-6" novalidate>
                                <div class="form-group">
                    <label for="name" class="block text-sm font-semibold text-gray-700 mb-2">
                        Product Name <span class="text-red-500">*</span>
                    </label>
                    <div class="input-with-mic flex gap-3">
                        <input 
                            type="text" 
                            id="name" 
                            name="name" 
                            required 
                            class="form-input flex-1 px-3 py-2.5 rounded-lg"
                            placeholder="e.g., Hand-woven Basket"
                            maxlength="100"
                        >
                        <button 
                            type="button" 
                            id="micName" 
                            class="mic-button flex items-center justify-center w-10 h-10 rounded-lg text-white border-none cursor-pointer"
                            title="Speak product name"
                            aria-label="Voice input for product name"
                        >
                            <i data-lucide="mic" class="w-4 h-4"></i>
                        </button>
                    </div>
                    <p id="nameStatus" class="text-xs text-gray-500 mt-1 min-h-[16px]"></p>
                </div>

                                <div class="form-group">
                    <label for="description" class="block text-sm font-semibold text-gray-700 mb-2">
                        Description <span class="text-red-500">*</span>
                    </label>
                    <div class="input-with-mic flex gap-3">
                        <textarea 
                            id="description" 
                            name="description" 
                            rows="3" 
                            required 
                            class="form-input flex-1 px-3 py-2.5 rounded-lg resize-vertical"
                            placeholder="Describe your product, its features, and benefits..."
                            maxlength="500"
                        ></textarea>
                        <button 
                            type="button" 
                            id="micDescription" 
                            class="mic-button flex items-center justify-center w-10 h-10 rounded-lg text-white border-none cursor-pointer"
                            title="Speak description"
                            aria-label="Voice input for description"
                        >
                            <i data-lucide="mic" class="w-4 h-4"></i>
                        </button>
                    </div>
                    <p id="descriptionStatus" class="text-xs text-gray-500 mt-1 min-h-[16px]"></p>
                    <p id="charCount" class="text-xs text-gray-400 mt-1">0/500 characters</p>
                </div>

                                <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
                    <div class="form-group">
                        <label for="price" class="block text-sm font-semibold text-gray-700 mb-2">
                            Price ($) <span class="text-red-500">*</span>
                        </label>
                        <div class="relative">
                            <span class="absolute left-3 top-1/2 transform -translate-y-1/2 text-gray-500 text-lg">$</span>
                            <input 
                                type="number" 
                                id="price" 
                                name="price" 
                                step="0.01" 
                                min="0" 
                                max="999999.99"
                                required 
                                class="form-input w-full pl-7 pr-3 py-2.5 rounded-lg"
                                placeholder="25.99"
                            >
                        </div>
                    </div>
                    
                    <div class="form-group">
                        <label for="category" class="block text-sm font-semibold text-gray-700 mb-2">
                            Category <span class="text-red-500">*</span>
                        </label>
                        <select id="category" name="category" required class="form-input w-full px-3 py-2.5 rounded-lg">
                            <option value="">Select a Category</option>
                            <option value="Agriculture">🌱 Agriculture</option>
                            <option value="Handicrafts">🎨 Handicrafts</option>
                            <option value="Food & Groceries">🍎 Food & Groceries</option>
                            <option value="Retail">🛍️ Retail</option>
                            <option value="Other">📦 Other</option>
                        </select>
                    </div>
                </div>

                                <div class="form-group">
                    <label for="imageUpload" class="block text-sm font-semibold text-gray-700 mb-2">
                        Product Image
                        <span class="text-gray-500 font-normal">(Optional)</span>
                    </label>
                    <div class="file-upload-area" id="fileUploadArea">
                        <input 
                            type="file" 
                            id="imageUpload" 
                            name="image" 
                            accept="image/*"
                            class="hidden"
                        >
                        <div id="uploadPrompt">
                            <div class="inline-flex items-center justify-center w-12 h-12 bg-blue-100 rounded-full mb-3">
                                <i data-lucide="upload" class="w-6 h-6 text-blue-600"></i>
                            </div>
                            <p class="text-gray-700 font-medium mb-2">Click to upload or drag and drop</p>
                            <p class="text-sm text-gray-500">PNG, JPG, GIF up to 10MB</p>
                        </div>
                    </div>
                    <div id="filePreview" class="file-preview hidden">
                        <div class="flex items-center justify-between">
                            <div class="flex items-center gap-3">
                                <img id="previewImage" src="" alt="Preview" class="w-16 h-16 object-cover rounded-lg">
                                <div>
                                    <p id="fileName" class="text-sm font-medium text-gray-700"></p>
                                    <p id="fileSize" class="text-xs text-gray-500"></p>
                                </div>
                            </div>
                            <button type="button" id="removeFile" class="text-red-500 hover:text-red-700 p-1">
                                <i data-lucide="x" class="w-4 h-4"></i>
                            </button>
                        </div>
                    </div>
                </div>

                                <div class="form-group">
                    <label for="contactInfo" class="block text-sm font-semibold text-gray-700 mb-2">
                        Contact Information
                    </label>
                    <input 
                        type="text" 
                        id="contactInfo" 
                        name="contactInfo" 
                        class="form-input w-full px-3 py-2.5 rounded-lg"
                        placeholder="e.g., +1234567890, email@example.com"
                        maxlength="200"
                    >
                </div>

                                <div class="form-buttons flex flex-col-reverse md:flex-row justify-end gap-3 mt-8 pt-6 border-t border-gray-200">
                    <a href="/user_dashboard" class="btn btn-secondary flex items-center justify-center gap-2 px-6 py-2.5 rounded-lg text-white font-semibold text-center no-underline">
                        <i data-lucide="arrow-left" class="w-4 h-4"></i>
                        <span>Back to Dashboard</span>
                    </a>
                    <button type="submit" class="btn btn-primary flex items-center justify-center gap-2 px-6 py-2.5 rounded-lg text-white font-semibold border-none cursor-pointer">
                        <i data-lucide="plus-circle" class="w-4 h-4"></i>
                        <span>Add Listing</span>
                    </button>
                </div>
            </form>
        </div>
    </div>

        <%- include('partials/footer') %>

    <script type="module">
        // Initialize Lucide icons
        lucide.createIcons();

        // App state
        let isSubmitting = false;
        let selectedImageFile = null;

        // DOM Elements
        const form = document.getElementById('addListingForm');
        const messageContainer = document.getElementById('messageContainer');
        const nameInput = document.getElementById('name');
        const descriptionInput = document.getElementById('description');
        const priceInput = document.getElementById('price');
        const categorySelect = document.getElementById('category');
        const charCount = document.getElementById('charCount');
        const contactInfoInput = document.getElementById('contactInfo');

        // File upload elements
        const fileUploadArea = document.getElementById('fileUploadArea');
        const imageUpload = document.getElementById('imageUpload');
        const uploadPrompt = document.getElementById('uploadPrompt');
        const filePreview = document.getElementById('filePreview');
        const previewImage = document.getElementById('previewImage');
        const fileName = document.getElementById('fileName');
        const fileSize = document.getElementById('fileSize');
        const removeFileBtn = document.getElementById('removeFile');

        // Voice input elements
        const micNameBtn = document.getElementById('micName');
        const micDescriptionBtn = document.getElementById('micDescription');
        const nameStatus = document.getElementById('nameStatus');
        const descriptionStatus = document.getElementById('descriptionStatus');

        // File Upload Handling
        function formatFileSize(bytes) {
            if (bytes === 0) return '0 Bytes';
            const k = 1024;
            const sizes = ['Bytes', 'KB', 'MB', 'GB'];
            const i = Math.floor(Math.log(bytes) / Math.log(k));
            return parseFloat((bytes / Math.pow(k, i)).toFixed(2)) + ' ' + sizes[i];
        }

        function handleFileSelect(file) {
            if (!file.type.startsWith('image/')) {
                showMessage('Please select an image file (PNG, JPG, GIF)', 'error');
                return;
            }

            if (file.size > 10 * 1024 * 1024) { // 10MB limit
                showMessage('File size must be less than 10MB', 'error');
                return;
            }

            selectedImageFile = file;
            
            // Create preview
            const reader = new FileReader();
            reader.onload = (e) => {
                previewImage.src = e.target.result;
                fileName.textContent = file.name;
                fileSize.textContent = formatFileSize(file.size);
                
                uploadPrompt.classList.add('hidden');
                filePreview.classList.remove('hidden');
            };
            reader.readAsDataURL(file);
        }

        function removeFile() {
            selectedImageFile = null;
            imageUpload.value = '';
            previewImage.src = '';
            fileName.textContent = '';
            fileSize.textContent = '';
            
            filePreview.classList.add('hidden');
            uploadPrompt.classList.remove('hidden');
        }

        // File upload click handler
        fileUploadArea.addEventListener('click', () => {
            imageUpload.click();
        });

        // File input change handler
        imageUpload.addEventListener('change', (e) => {
            const file = e.target.files[0];
            if (file) {
                handleFileSelect(file);
            }
        });

        // Drag and drop handlers
        fileUploadArea.addEventListener('dragover', (e) => {
            e.preventDefault();
            fileUploadArea.classList.add('dragover');
        });

        fileUploadArea.addEventListener('dragleave', () => {
            fileUploadArea.classList.remove('dragover');
        });

        fileUploadArea.addEventListener('drop', (e) => {
            e.preventDefault();
            fileUploadArea.classList.remove('dragover');
            
            const files = e.dataTransfer.files;
            if (files.length > 0) {
                handleFileSelect(files[0]);
            }
        });

        // Remove file button
        removeFileBtn.addEventListener('click', (e) => {
            e.stopPropagation();
            removeFile();
        });

        // Utility Functions
        function showMessage(text, type = 'success') {
            const messageDiv = document.createElement('div');
            messageDiv.className = `message ${type === 'success' 
                ? 'bg-gradient-to-r from-green-50 to-emerald-50 text-green-800 border-l-4 border-green-400' 
                : 'bg-gradient-to-r from-red-50 to-pink-50 text-red-800 border-l-4 border-red-400'}`;
            messageDiv.innerHTML = `
                <div class="flex items-center justify-center gap-3">
                    <i data-lucide="${type === 'success' ? 'check-circle' : 'alert-triangle'}" class="w-6 h-6"></i>
                    <span class="text-lg font-medium">${text}</span>
                </div>
            `;
            messageContainer.innerHTML = '';
            messageContainer.appendChild(messageDiv);
            lucide.createIcons();

            // Auto-hide success messages
            if (type === 'success') {
                setTimeout(() => {
                    messageDiv.style.opacity = '0';
                    messageDiv.style.transform = 'translateY(-20px)';
                    setTimeout(() => messageDiv.remove(), 300);
                }, 5000);
            }
        }

        function setLoading(loading) {
            isSubmitting = loading;
            const submitBtn = form.querySelector('button[type="submit"]');

            if (loading) {
                form.classList.add('loading');
                submitBtn.disabled = true;
                submitBtn.innerHTML = '<div class="spinner"></div><span>Creating Listing...</span>';
            } else {
                form.classList.remove('loading');
                submitBtn.disabled = false;
                submitBtn.innerHTML = '<i data-lucide="plus-circle" class="w-5 h-5"></i><span>Add Listing</span>';
                lucide.createIcons();
            }
        }

        // Character count for description
        descriptionInput.addEventListener('input', () => {
            const count = descriptionInput.value.length;
            charCount.textContent = `${count}/500 characters`;
            charCount.className = count > 450 ? 'text-xs text-red-500 mt-1' : 'text-xs text-gray-400 mt-1';
        });

        // Voice Recognition Setup
        const SpeechRecognition = window.SpeechRecognition || window.webkitSpeechRecognition;
        const recognitionAvailable = SpeechRecognition !== undefined;

        if (!recognitionAvailable) {
            micNameBtn.disabled = true;
            micDescriptionBtn.disabled = true;
            micNameBtn.classList.add('opacity-50', 'cursor-not-allowed');
            micDescriptionBtn.classList.add('opacity-50', 'cursor-not-allowed');
            nameStatus.textContent = "Voice input not available";
            descriptionStatus.textContent = "Voice input not available";
        } else {
            function setupVoiceRecognition(inputElement, statusElement, micButton) {
                const recognition = new SpeechRecognition();
                recognition.continuous = false;
                recognition.lang = 'en-US';
                recognition.interimResults = false;
                recognition.maxAlternatives = 1;

                let isRecording = false;

                recognition.onstart = () => {
                    isRecording = true;
                    micButton.classList.add('recording');
                    statusElement.textContent = "🎤 Listening... Speak now";
                    micButton.innerHTML = '<i data-lucide="pause-circle" class="w-4 h-4"></i>';
                    lucide.createIcons();
                };

                recognition.onresult = (event) => {
                    const transcript = event.results[0][0].transcript;
                    const currentValue = inputElement.value;
                    inputElement.value = currentValue ? `${currentValue} ${transcript}` : transcript;
                    statusElement.textContent = `✅ Added: "${transcript}"`;

                    // Update character count if it's the description field
                    if (inputElement === descriptionInput) {
                        descriptionInput.dispatchEvent(new Event('input'));
                    }
                };

                recognition.onerror = (event) => {
                    console.error("Speech recognition error:", event.error);
                    statusElement.textContent = `❌ Error: ${event.error}. Try again.`;
                };

                recognition.onend = () => {
                    isRecording = false;
                    micButton.classList.remove('recording');
                    micButton.innerHTML = '<i data-lucide="mic" class="w-4 h-4"></i>';
                    lucide.createIcons();
                };

                micButton.addEventListener('click', async () => {
                    if (isRecording) {
                        recognition.stop();
                        return;
                    }

                    try {
                        // Request microphone permission
                        await navigator.mediaDevices.getUserMedia({ audio: true });
                        recognition.start();
                    } catch (error) {
                        console.error("Microphone permission denied:", error);
                        statusElement.textContent = "❌ Microphone access denied. Please allow and try again.";
                    }
                });
            }

            setupVoiceRecognition(nameInput, nameStatus, micNameBtn);
            setupVoiceRecognition(descriptionInput, descriptionStatus, micDescriptionBtn);
        }

        // Form Validation
        function validateForm() {
            const name = nameInput.value.trim();
            const description = descriptionInput.value.trim();
            const price = parseFloat(priceInput.value);
            const category = categorySelect.value;
            const contactInfo = contactInfoInput.value.trim();

            if (!name) {
                nameInput.focus();
                showMessage("Please enter a product name.", "error");
                return false;
            }

            if (!description) {
                descriptionInput.focus();
                showMessage("Please enter a product description.", "error");
                return false;
            }

            if (isNaN(price) || price < 0) {
                priceInput.focus();
                showMessage("Please enter a valid price.", "error");
                return false;
            }

            if (!category) {
                categorySelect.focus();
                showMessage("Please select a category.", "error");
                return false;
            }
            
            return true;
        }

        // Form Submission
        form.addEventListener('submit', async (event) => {
            event.preventDefault();

            if (isSubmitting) return;

            if (!validateForm()) return;

            setLoading(true);

            try {
                // Use FormData for file upload
                const formData = new FormData();
                formData.append('name', nameInput.value.trim());
                formData.append('description', descriptionInput.value.trim());
                formData.append('price', parseFloat(priceInput.value));
                formData.append('category', categorySelect.value);
                formData.append('contactInfo', contactInfoInput.value.trim());
                
                // Append the image file if selected
                if (selectedImageFile) {
                    formData.append('image', selectedImageFile);
                }
                
                // Send data to Node.js backend API
                const response = await fetch('/user/listings', {
                    method: 'POST',
                    body: formData // FormData handles Content-Type automatically
                });
                
                const result = await response.json();

                if (response.ok) {
                    console.log("✅ Listing added successfully:", result.listing);
                    showMessage("🎉 Product listing created successfully! Your product is now live.");

                    // Reset form
                    form.reset();
                    charCount.textContent = "0/500 characters";
                    charCount.className = "text-xs text-gray-400 mt-1";
                    nameStatus.textContent = "";
                    descriptionStatus.textContent = "";
                    
                    // Reset file upload
                    removeFile();
                    
                    // Scroll to top to show success message
                    window.scrollTo({ top: 0, behavior: 'smooth' });
                    
                } else {
                    console.error("❌ Error adding listing:", result.error);
                    showMessage(`Failed to create listing: ${result.error || 'Unknown error'}`, "error");
                }
            } catch (error) {
                console.error("❌ Network Error during listing submission:", error);
                showMessage(`Network error. Please check your connection and try again. (${error.message})`, "error");
            } finally {
                setLoading(false);
            }
        });

        // Initialize tooltips and accessibility
        document.addEventListener('DOMContentLoaded', () => {
            const requiredFields = document.querySelectorAll('input[required], select[required], textarea[required]');
            requiredFields.forEach(field => {
                field.setAttribute('aria-required', 'true');
            });
        });
    </script>
</body>
</html>