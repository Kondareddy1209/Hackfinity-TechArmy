            <!-- E. Poojitha -->
            <div class="team-member-card">
                <div class="team-member-avatar">
                    <img src="https://github.com/192211190.png" alt="E. Poojitha's Avatar" onerror="this.src='https://ui-avatars.com/api/?name=E.+Poojitha&background=667eea&color=fff&size=120'">
                </div>
                <h3 class="team-member-name">E. Poojitha</h3>
                <p class="team-member-role">Data Analyst & UI Designer</p>
                <p class="team-member-bio">Loves analyzing energy trends and designing intuitive user experiences.</p>
