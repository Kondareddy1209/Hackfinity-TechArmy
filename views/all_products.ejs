<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>All Products • MyGreenHome</title>

    <link rel="preconnect" href="https://cdn.tailwindcss.com">
    <link rel="dns-prefetch" href="https://cdn.tailwindcss.com">
    <link rel="preconnect" href="https://unpkg.com">
    <link rel="dns-prefetch" href="https://unpkg.com">
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="dns-prefetch" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link rel="dns-prefetch" href="https://fonts.gstatic.com">

    <script src="https://cdn.tailwindcss.com"></script>
    <script src="https://unpkg.com/lucide@latest"></script>
    <style>
        @import url('https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800&display=swap');

        body {
            font-family: 'Inter', -apple-system, BlinkMacSystemFont, 'Segoe UI', sans-serif;
            min-height: 100vh;
            background-color: #f0f2f5;
            background-attachment: fixed;
            display: flex;
            flex-direction: column;
        }

        .main-content-wrapper {
            flex-grow: 1;
            /* Further increased max-width for a very large container */
            max-width: 1500px; /* Increased from 1400px */
            margin: 35px auto; /* Adjusted margin */
            padding: 35px; /* Increased padding */
            background: rgba(255, 255, 255, 0.95);
            backdrop-filter: blur(10px);
            border-radius: 25px; /* Slightly larger border-radius */
            box-shadow: 0 35px 70px rgba(0, 0, 0, 0.2); /* Stronger shadow */
        }

        .search-section {
            background: #ffffff;
            border-radius: 20px; /* Adjusted border-radius */
            padding: 2rem; /* Increased padding */
            margin-bottom: 2rem; /* Increased margin-bottom */
            box-shadow: 0 12px 25px rgba(0, 0, 0, 0.12); /* Stronger shadow */
            border: 1px solid #c0c0c0; /* Slightly darker border */
        }

        .search-container {
            display: flex;
            gap: 18px; /* Increased gap */
            align-items: stretch;
            flex-wrap: wrap;
        }

        .search-input-container {
            position: relative;
            flex: 1;
            min-width: 350px; /* Increased min-width */
        }

        .search-input {
            width: 100%;
            padding: 16px 22px 16px 55px; /* Adjusted padding */
            font-size: 18px; /* Increased font-size */
            border: 1px solid #a0a0a0; /* Stronger border */
            border-radius: 16px; /* Adjusted border-radius */
            background: white;
            transition: all 0.3s ease;
            box-shadow: none;
        }

        .search-input:focus {
            outline: none;
            border-color: #3b82f6;
            box-shadow: 0 0 0 4px rgba(59, 130, 246, 0.4); /* Stronger focus shadow */
        }

        .search-input-icon {
            position: absolute;
            left: 20px; /* Adjusted icon position */
            top: 50%;
            transform: translateY(-50%);
            color: #333; /* Darker color */
            z-index: 2;
            width: 24px; /* Increased icon size */
            height: 24px; /* Increased icon size */
        }

        .search-controls {
            display: flex;
            gap: 12px; /* Increased gap */
            flex-wrap: wrap;
        }

        .search-btn {
            padding: 16px; /* Increased padding */
            border-radius: 16px; /* Adjusted border-radius */
            border: none;
            cursor: pointer;
            display: flex;
            align-items: center;
            justify-content: center;
            transition: all 0.2s ease;
            font-weight: 600;
            box-shadow: 0 4px 8px rgba(0, 0, 0, 0.15); /* Added subtle shadow */
            position: relative;
            overflow: hidden;
        }

        .search-btn::before {
            content: '';
            position: absolute;
            top: 0;
            left: -100%;
            width: 100%;
            height: 100%;
            background: linear-gradient(90deg, transparent, rgba(255, 255, 255, 0.5), transparent); /* Stronger shimmer */
            transition: left 0.4s;
        }

        .search-btn:hover::before {
            left: 100%;
        }

        .search-btn:hover {
            transform: translateY(-2px); /* Slight hover lift */
            box-shadow: 0 6px 18px rgba(0, 0, 0, 0.2); /* Increased hover shadow */
        }

        .search-btn.primary {
            background: #3b82f6;
            color: white;
        }

        .search-btn.secondary {
            background: #8b5cf6;
            color: white;
        }

        .search-btn.tertiary {
            background: #6b7280;
            color: white;
        }

        /* Product Grid Changes - Main focus for 3 items per row */
        .product-grid {
            /* Exactly 3 products per row on larger screens */
            grid-template-columns: repeat(3, 1fr); /* Explicitly 3 columns */
            gap: 30px; /* Increased gap for more spacing */
            margin-top: 3rem; /* Increased margin-top */
            display: grid;
        }

        .product-card {
            background: white;
            border-radius: 16px; /* Increased border-radius */
            overflow: hidden;
            transition: all 0.2s ease;
            box-shadow: 0 6px 22px rgba(0, 0, 0, 0.1); /* Slightly stronger shadow */
            border: 1px solid #c0c0c0; /* Slightly darker border */
            position: relative;
            cursor: pointer;
        }

        .product-card::before {
            display: none;
        }

        .product-card:hover {
            transform: translateY(-5px); /* More pronounced hover lift */
            box-shadow: 0 12px 35px rgba(0, 0, 0, 0.25); /* Stronger hover shadow */
        }

        .product-card-image-container {
            width: 100%;
            /* Maintain a square-like aspect ratio for the image container */
            padding-bottom: 100%; /* Makes the height equal to the width */
            position: relative;
            overflow: hidden;
            background: #f3f4f6;
            display: flex; /* Use flexbox to center the image */
            align-items: center;
            justify-content: center;
        }

        .product-card-image {
            position: absolute; /* Position absolutely within the padded container */
            top: 0;
            left: 0;
            width: 100%;
            height: 100%;
            object-fit: contain; /* Ensures the image fits within the box without cropping, preserving aspect ratio */
            transition: transform 0.2s ease;
        }

        .product-card:hover .product-card-image {
            transform: scale(1.02); /* Slight hover scale */
        }

        .product-card-body {
            padding: 25px; /* Increased padding */
            position: relative;
            z-index: 2;
        }

        .product-card-title {
            font-size: 1.3rem; /* Increased font size */
            font-weight: 700;
            color: #1f2937;
            margin-bottom: 12px; /* Increased margin */
            line-height: 1.5;
            background: none;
            -webkit-background-clip: unset;
            -webkit-text-fill-color: initial;
            background-clip: unset;
        }

        .product-card-description {
            display: none;
        }

        .product-card-keywords {
            display: none;
        }

        .product-card-footer {
            padding: 18px 25px; /* Increased padding */
            background: #f9fafb;
            display: flex;
            justify-content: space-between;
            align-items: center;
            border-top: 1px solid #e0e0e0; /* Slightly darker border */
            position: relative;
            z-index: 2;
        }

        .product-price {
            font-size: 1.4rem; /* Increased font size */
            font-weight: 800;
            background: #059669;
            -webkit-background-clip: unset;
            -webkit-text-fill-color: initial;
            background-clip: unset;
            color: #059669;
        }

        .product-category {
            font-size: 0.85rem; /* Slightly increased font size */
            color: #555;
            background: #e5e7eb;
            padding: 6px 12px; /* Increased padding */
            border-radius: 16px; /* Increased border-radius */
            font-weight: 600;
            text-transform: uppercase;
            letter-spacing: 1.2px; /* Increased letter spacing */
        }

        .loading-grid {
            display: grid;
            grid-template-columns: repeat(3, 1fr); /* Matched product grid */
            gap: 30px; /* Matched product grid */
            margin-top: 3rem;
        }

        .loading-card {
            background: white;
            border-radius: 16px;
            overflow: hidden;
            /* Adjusted height to match new, larger product card size with image padding-bottom trick */
            height: 480px; /* (220px image height + ~100% padding-bottom) + body padding + footer padding */
            box-shadow: 0 6px 22px rgba(0, 0, 0, 0.1);
        }

        /* Adjust skeleton heights for larger cards */
        .loading-card .skeleton.h-44 { /* For image area */
            height: 220px; /* Match product-card-image-container height */
            padding-bottom: 0; /* Remove padding-bottom from skeleton itself */
        }
        .loading-card .skeleton.h-6 { /* For title */
            height: 1.3rem; /* Match product-card-title */
            margin-bottom: 12px;
        }
        .loading-card .skeleton.h-4 { /* For description/text lines */
            height: 1rem;
            margin-bottom: 8px;
        }
        .loading-card .skeleton.h-7 { /* For price */
            height: 1.4rem;
        }
        .loading-card .skeleton.h-6 { /* For category */
            height: 1.1rem;
        }


        .no-products-message {
            grid-column: 1 / -1;
            text-align: center;
            padding: 4.5rem 2.5rem;
            color: #6b7280;
            font-size: 1.3rem;
            background: white;
            border-radius: 20px;
            box-shadow: 0 10px 25px rgba(0, 0, 0, 0.12);
        }

        .search-status {
            text-align: center;
            margin: 1.5rem 0;
            padding: 1.2rem;
            border-radius: 12px;
            background: rgba(255, 255, 255, 0.9);
            backdrop-filter: blur(8px);
            font-weight: 600;
            font-size: 1.1rem;
            color: #4a5568;
        }

        .back-to-dashboard-link {
            display: inline-flex;
            align-items: center;
            gap: 12px;
            margin-top: 3rem;
            padding: 14px 30px;
            background: #6b7280;
            color: white;
            border-radius: 14px;
            font-weight: 700;
            text-decoration: none;
            transition: all 0.2s ease;
            box-shadow: 0 6px 18px rgba(0, 0, 0, 0.18);
            position: relative;
            overflow: hidden;
        }

        .back-to-dashboard-link::before {
            content: '';
            position: absolute;
            top: 0;
            left: -100%;
            width: 100%;
            height: 100%;
            background: linear-gradient(90deg, transparent, rgba(255, 255, 255, 0.35), transparent);
            transition: left 0.4s;
        }

        .back-to-dashboard-link:hover::before {
            left: 100%;
        }

        .back-to-dashboard-link:hover {
            transform: translateY(-3px);
            box-shadow: 0 12px 35px rgba(0, 0, 0, 0.3);
        }

        .icon {
            width: 20px;
            height: 20px;
            stroke: currentColor;
            fill: none;
            stroke-width: 2;
        }

        .spinner {
            animation: spin 1s linear infinite;
        }

        @keyframes spin {
            0% {
                transform: rotate(0deg);
            }

            100% {
                transform: rotate(360deg);
            }
        }

        /* Responsive Adjustments */
        @media (max-width: 1400px) {
            .product-grid {
                grid-template-columns: repeat(3, 1fr); /* Maintain 3 columns as long as possible */
            }
        }

        @media (max-width: 1024px) {
            .main-content-wrapper {
                margin: 25px;
                padding: 25px;
                border-radius: 20px;
            }
            .product-grid {
                grid-template-columns: repeat(2, 1fr); /* 2 columns on tablets */
                gap: 25px;
            }
            .product-card-image-container {
                height: 180px; /* Adjust image height for 2 columns */
                padding-bottom: 0; /* Override padding-bottom on smaller screens for fixed height */
            }
            .product-card-image {
                position: static; /* Adjust positioning */
            }
            .loading-card {
                height: auto; /* Allow height to adjust for 2 columns */
            }
            .loading-card .skeleton.h-44 {
                height: 180px;
            }
        }

        @media (max-width: 768px) {
            .main-content-wrapper {
                margin: 15px;
                padding: 18px;
                border-radius: 15px;
            }
            .search-section {
                padding: 1.5rem;
                margin-bottom: 1.5rem;
                border-radius: 15px;
            }
            .search-input {
                padding: 12px 18px 12px 45px;
                font-size: 16px;
            }
            .search-input-icon {
                left: 15px;
                width: 20px;
                height: 20px;
            }
            .search-btn {
                padding: 12px;
                font-size: 0.95rem;
            }
            .product-grid {
                grid-template-columns: 1fr; /* Single column on mobile */
                gap: 20px;
                margin-top: 2rem;
            }
            .product-card-image-container {
                height: 200px; /* Make image taller on single column mobile view */
                padding-bottom: 0; /* Ensure fixed height */
            }
            .loading-card {
                height: auto;
            }
            .loading-card .skeleton.h-44 {
                height: 200px;
            }
            .product-card-body {
                padding: 20px;
            }
            .product-card-title {
                font-size: 1.2rem;
            }
            .product-price {
                font-size: 1.3rem;
            }
            .product-category {
                font-size: 0.8rem;
            }
            .no-products-message {
                font-size: 1.1rem;
                padding: 3rem 1.5rem;
            }
            .search-status {
                font-size: 0.9rem;
                padding: 1rem;
            }
            .back-to-dashboard-link {
                padding: 10px 20px;
                font-size: 0.9rem;
            }
        }

        @media (max-width: 480px) {
            .search-input {
                min-width: unset;
            }
            .search-controls {
                justify-content: center; /* Center buttons if they wrap */
                width: 100%;
            }
            .product-card-image-container {
                height: 160px; /* Slightly smaller image on very small screens */
            }
            .loading-card .skeleton.h-44 {
                height: 160px;
            }
        }
    </style>
</head>

<body>

    <%- include('partials/navbar') %>

    <div class="main-content-wrapper">
        <div class="search-section">
            <div class="search-container">
                <div class="search-input-container">
                    <input type="text" id="productSearchInput"
                        placeholder="Search for eco-friendly products..."
                        class="search-input">
                    <svg class="search-input-icon icon" xmlns="http://www.w3.org/2000/svg"
                        viewBox="0 0 24 24">
                        <circle cx="11" cy="11" r="8" />
                        <path d="m21 21-4.35-4.35" />
                    </svg>
                </div>
                <div class="search-controls">
                    <button type="button" id="micSearchBtn" class="search-btn primary"
                        title="Voice Search">
                        <svg class="icon" xmlns="http://www.w3.org/2000/svg"
                            viewBox="0 0 24 24">
                            <path d="M12 2a3 3 0 0 0-3 3v7a3 3 0 0 0 6 0V5a3 3 0 0 0-3-3Z" />
                            <path d="M19 10v2a7 7 0 0 1-14 0v-2" />
                            <line x1="12" x2="12" y1="19" y2="22" />
                            <line x1="8" x2="16" y1="22" y2="22" />
                        </svg>
                    </button>
                    <label for="imageSearchInput" class="search-btn secondary"
                        title="Image Search">
                        <svg class="icon" xmlns="http://www.w3.org/2000/svg"
                            viewBox="0 0 24 24">
                            <rect width="18" height="18" x="3" y="3" rx="2" ry="2" />
                            <circle cx="9" cy="9" r="2" />
                            <path d="m21 15-3.086-3.086a2 2 0 0 0-2.828 0L6 21" />
                        </svg>
                        <input type="file" id="imageSearchInput" accept="image/*"
                            class="hidden">
                    </label>
                    <button type="button" id="resetSearchBtn" class="search-btn tertiary"
                        title="Reset Search">
                        <svg class="icon" xmlns="http://www.w3.org/2000/svg"
                            viewBox="0 0 24 24">
                            <path d="M3 12a9 9 0 0 1 9-9 9.75 9.75 0 0 1 6.74 2.74L21 8" />
                            <path d="M21 3v5h-5" />
                            <path d="M21 12a9 9 0 0 1-9 9 9.75 9.75 0 0 1-6.74-2.74L3 16" />
                            <path d="M8 16H3v5" />
                        </svg>
                    </button>
                </div>
            </div>
            <div>
                <label for="productCategoryFilter" class="block text-gray-700 text-sm font-bold mb-2">Category:</label>
                <select id="productCategoryFilter"
                    class="shadow appearance-none border rounded w-full py-2 px-3 text-gray-700 leading-tight focus:outline-none focus:shadow-outline">
                    <option value="">All Categories</option>
                    <option value="Agriculture & Farming">🌱 Agriculture & Farming</option>
                    <option value="Arts & Handicrafts">🎨 Arts & Handicrafts</option>
                    <option value="Food & Groceries">🍎 Food & Groceries</option>
                    <option value="Retail & Fashion">🛍️ Retail & Fashion</option>
                    <option value="Technology">💻 Technology</option>
                    <option value="Home & Garden">🏡 Home & Garden</option>
                    <option value="Services">🛠️ Services</option>
                    <option value="Other">📦 Other</option>
                </select>
            </div>
        </div>

        <div id="searchStatus" class="search-status"></div>

        <div class="product-grid" id="dynamicProductGrid">
            <div class="loading-grid" id="initialLoadingGrid">
                <% for(let i=0; i < 6; i++) { %>
                <div class="loading-card">
                    <div class="skeleton h-44"></div>
                    <div class="p-5">
                        <div class="skeleton h-6 mb-2 rounded"></div>
                        <div class="skeleton h-4 mb-1 rounded"></div>
                        <div class="skeleton h-4 mb-3 rounded w-3/4"></div>
                        <div class="flex justify-between items-center">
                            <div class="skeleton h-7 w-24 rounded"></div>
                            <div class="skeleton h-6 w-18 rounded-full"></div>
                        </div>
                    </div>
                </div>
                <% } %>
            </div>
        </div>

        <div class="flex justify-center mt-8">
            <button id="loadMoreBtn" class="search-btn primary" style="display: none;">
                <svg class="icon" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24">
                    <path d="M12 5v14M5 12h14" />
                </svg>
                Load More Products
            </button>
        </div>

        <div class="flex justify-center mt-8">
            <a href="/user_dashboard" class="back-to-dashboard-link">
                <svg class="icon" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24">
                    <path d="m12 19-7-7 7-7" />
                    <path d="M19 12H5" />
                </svg>
                <span>Back to Dashboard</span>
            </a>
        </div>
    </div>

    <%- include('partials/footer') %>

    <script>
        document.addEventListener('DOMContentLoaded', () => {
            const productSearchInput = document.getElementById('productSearchInput');
            const productCategoryFilter = document.getElementById('productCategoryFilter');
            const micSearchBtn = document.getElementById('micSearchBtn');
            const imageSearchInput = document.getElementById('imageSearchInput');
            const resetSearchBtn = document.getElementById('resetSearchBtn');
            const searchStatus = document.getElementById('searchStatus');
            const dynamicProductGrid = document.getElementById('dynamicProductGrid');
            const initialLoadingGridHtml = dynamicProductGrid.innerHTML;
            const loadMoreBtn = document.getElementById('loadMoreBtn');

            let allLoadedProducts = [];
            const productsPerPage = 12; // Number of products to load per page/request
            let currentPage = 1;
            let currentSearchQuery = '';
            let currentCategoryFilter = '';
            let totalProductsCount = 0; // Total number of products available on the server

            // Event listener for "Load More" button
            loadMoreBtn.addEventListener('click', () => {
                currentPage++;
                fetchProducts(currentSearchQuery, currentCategoryFilter, currentPage, productsPerPage, true);
            });

            // Event listener for category filter change
            productCategoryFilter.addEventListener('change', () => {
                currentCategoryFilter = productCategoryFilter.value;
                currentPage = 1; // Reset to first page when filter changes
                fetchProducts(currentSearchQuery, currentCategoryFilter, currentPage, productsPerPage);
            });

            /**
             * Renders product cards into the grid.
             * @param {Array} productsToRender - The array of product objects to render.
             * @param {boolean} append - If true, appends products; otherwise, replaces existing ones.
             */
            function renderProducts(productsToRender, append = false) {
                if (!append) {
                    dynamicProductGrid.innerHTML = ''; // Clear grid if not appending
                }

                if (productsToRender.length === 0 && allLoadedProducts.length === 0 && !append) {
                    // Display message if no products found after a search/filter, and no products were previously loaded
                    dynamicProductGrid.innerHTML = '<div class="no-products-message">🔍 No products found matching your criteria.<br><span style="font-size: 0.9rem; margin-top: 0.8rem; display: block; opacity: 0.7;">Try adjusting your search terms or filters.</span></div>';
                    loadMoreBtn.style.display = 'none'; // Hide load more button
                    return;
                }

                const fragment = document.createDocumentFragment();

                productsToRender.forEach(product => {
                    const productCard = document.createElement('div');
                    productCard.classList.add('product-card');
                    productCard.innerHTML = `
                        <div class="product-card-image-container">
                            <img src="${product.imageUrl || '/images/default_product.png'}"
                                alt="${product.name || 'Product Image'}"
                                class="product-card-image"
                                onerror="this.src='/images/default_product.png'"
                                loading="lazy">
                        </div>
                        <div class="product-card-body">
                            <h3 class="product-card-title">${product.name || 'Untitled Product'}</h3>
                            <p class="product-card-description">${product.description || 'No description available.'}</p>
                        </div>
                        <div class="product-card-footer">
                            <span class="product-price">$${(parseFloat(product.price) || 0).toFixed(2)}</span>
                            <span class="product-category">${product.category || 'Uncategorized'}</span>
                        </div>
                    `;
                    fragment.appendChild(productCard);
                });
                dynamicProductGrid.appendChild(fragment);

                // Show/hide load more button based on total products and loaded products
                if (allLoadedProducts.length < totalProductsCount) {
                    loadMoreBtn.style.display = 'block';
                } else {
                    loadMoreBtn.style.display = 'none';
                }

                // Initialize Lucide icons after new elements are added
                lucide.createIcons();
            }

            /**
             * Fetches products from the API.
             * @param {string} query - Search query string.
             * @param {string} category - Category filter string.
             * @param {number} page - Page number for pagination.
             * @param {number} limit - Number of products per page.
             * @param {boolean} append - If true, appends fetched products to existing ones.
             */
            async function fetchProducts(query = '', category = '', page = 1, limit = productsPerPage, append = false) {
                searchStatus.innerHTML = '<svg class="icon spinner inline-block mr-2" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24"><path d="M21 12a9 9 0 1 1-6.219-8.56"/></svg> Loading products...';
                loadMoreBtn.disabled = true;
                loadMoreBtn.innerHTML = '<svg class="icon spinner inline-block mr-2" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24"><path d="M21 12a9 9 0 1 1-6.219-8.56"/></svg> Loading...';

                if (!append) {
                    dynamicProductGrid.innerHTML = initialLoadingGridHtml; // Show skeleton loaders
                }

                try {
                    const response = await fetch(`/api/products?q=${encodeURIComponent(query)}&category=${encodeURIComponent(category)}&page=${page}&limit=${limit}`);
                    if (!response.ok) {
                        throw new Error(`HTTP error! status: ${response.status}`);
                    }
                    const data = await response.json();

                    totalProductsCount = data.totalProducts;

                    if (append) {
                        allLoadedProducts = allLoadedProducts.concat(data.products);
                    } else {
                        allLoadedProducts = data.products;
                    }

                    renderProducts(data.products, append);
                    searchStatus.textContent = `Displaying ${allLoadedProducts.length} of ${totalProductsCount} products.`;

                } catch (error) {
                    console.error("Failed to fetch products:", error);
                    searchStatus.innerHTML = '<span style="color: #ef4444;">❌ Failed to load products. Please try again.</span>';
                    dynamicProductGrid.innerHTML = '<div class="no-products-message">Failed to load products. Network error or server issue.</div>';
                    loadMoreBtn.style.display = 'none';
                } finally {
                    loadMoreBtn.disabled = false;
                    loadMoreBtn.innerHTML = '<svg class="icon" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24"><path d="M12 5v14M5 12h14"/></svg> Load More Products';
                }
            }

            // Initial load of products when the page loads
            fetchProducts();

            let searchTimeout;
            productSearchInput.addEventListener('input', () => {
                clearTimeout(searchTimeout);
                searchStatus.textContent = ''; // Clear status while typing
                searchTimeout = setTimeout(() => {
                    currentSearchQuery = productSearchInput.value.trim();
                    currentPage = 1; // Reset to first page for new search
                    fetchProducts(currentSearchQuery, currentCategoryFilter, currentPage, productsPerPage);
                }, 300); // Debounce search input for performance
            });

            // Speech Recognition (Voice Search)
            const SpeechRecognition = window.SpeechRecognition || window.webkitSpeechRecognition;
            if (SpeechRecognition) {
                const recognition = new SpeechRecognition();
                recognition.continuous = false; // Capture a single phrase
                recognition.lang = 'en-US';
                recognition.interimResults = false; // Only return final results

                micSearchBtn.addEventListener('click', () => {
                    micSearchBtn.innerHTML = '<svg class="icon spinner" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24"><path d="M21 12a9 9 0 1 1-6.219-8.56"/></svg>';
                    searchStatus.innerHTML = '🎤 Listening... Speak now.';
                    try {
                        recognition.start();
                    } catch (e) {
                        console.error("Speech recognition start error:", e);
                        searchStatus.innerHTML = '<span style="color: #ef4444;">❌ Microphone error. Please allow access.</span>';
                        resetMicButton();
                    }
                });

                recognition.onresult = (event) => {
                    const transcript = event.results[0][0].transcript;
                    productSearchInput.value = transcript;
                    searchStatus.innerHTML = `✨ Transcribed: "${transcript}"`;
                    currentSearchQuery = transcript;
                    currentPage = 1;
                    fetchProducts(currentSearchQuery, currentCategoryFilter, currentPage, productsPerPage);
                };

                recognition.onerror = (event) => {
                    searchStatus.innerHTML = `<span style="color: #ef4444;">❌ Voice search error: ${event.error}</span>`;
                    console.error('Speech recognition error:', event.error);
                    resetMicButton();
                };

                recognition.onend = () => {
                    resetMicButton();
                    // If no speech was detected but the listener ended
                    if (searchStatus.textContent.includes('Listening')) {
                        searchStatus.innerHTML = '🔇 No speech detected. Please try again.';
                    }
                };

                function resetMicButton() {
                    micSearchBtn.innerHTML = '<svg class="icon" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24"><path d="M12 2a3 3 0 0 0-3 3v7a3 3 0 0 0 6 0V5a3 3 0 0 0-3-3Z"/><path d="M19 10v2a7 7 0 0 1-14 0v-2"/><line x1="12" x2="12" y1="19" y2="22"/><line x1="8" x2="16" y1="22" y2="22"/></svg>';
                }
            } else {
                // Disable mic button if API is not supported
                micSearchBtn.disabled = true;
                micSearchBtn.style.opacity = '0.5';
                searchStatus.innerHTML = '⚠️ Voice search not supported in this browser.';
            }

            // Image Search
            imageSearchInput.addEventListener('change', async (event) => {
                const file = event.target.files[0];
                if (!file) {
                    searchStatus.textContent = '';
                    return;
                }

                // Basic file validation (image type and size)
                const allowedTypes = ['image/jpeg', 'image/jpg', 'image/png', 'image/gif'];
                const maxSize = 5 * 1024 * 1024; // 5MB

                if (!allowedTypes.includes(file.type) || file.size > maxSize) {
                    searchStatus.innerHTML = '<span style="color: #ef4444;">❌ Invalid image format or size (JPG/PNG/GIF, max 5MB).</span>';
                    event.target.value = ''; // Clear file input
                    return;
                }

                searchStatus.innerHTML = '<svg class="icon spinner inline-block mr-2" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24"><path d="M21 12a9 9 0 1 1-6.219-8.56"/></svg> 🔍 Analyzing image...';

                const formData = new FormData();
                formData.append('image', file);
                formData.append('query', productSearchInput.value.trim()); // Send current text query as well if any

                try {
                    const response = await fetch('/api/search-by-image', {
                        method: 'POST',
                        body: formData
                    });
                    const result = await response.json();

                    if (response.ok) {
                        const searchKeywords = Array.isArray(result.keywords) ? result.keywords.join(', ') : result.query || '';
                        productSearchInput.value = searchKeywords; // Populate search input with analyzed keywords
                        searchStatus.innerHTML = `✨ Image analysis complete. Searching for: "${searchKeywords}"`;
                        currentSearchQuery = searchKeywords;
                        currentPage = 1;
                        fetchProducts(currentSearchQuery, currentCategoryFilter, currentPage, productsPerPage);
                    } else {
                        searchStatus.innerHTML = `<span style="color: #ef4444;">❌ Error analyzing image: ${result.message || 'Unknown error'}.</span>`;
                    }
                } catch (error) {
                    console.error('Image search API error:', error);
                    searchStatus.innerHTML = '<span style="color: #ef4444;">❌ Network error analyzing image</span>';
                } finally {
                    event.target.value = ''; // Clear file input after upload/analysis
                }
            });

            // Reset Search Button
            resetSearchBtn.addEventListener('click', () => {
                productSearchInput.value = '';
                productCategoryFilter.value = '';
                searchStatus.textContent = '';
                currentSearchQuery = '';
                currentCategoryFilter = '';
                currentPage = 1;
                allLoadedProducts = []; // Clear loaded products to force a fresh fetch
                fetchProducts(); // Fetch all products again
            });
        });
    </script>
</body>

</html>