<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>All Products • MyGreenHome</title>

    <link rel="preconnect" href="https://cdn.tailwindcss.com">
    <link rel="dns-prefetch" href="https://cdn.tailwindcss.com">
    <link rel="preconnect" href="https://unpkg.com">
    <link rel="dns-prefetch" href="https://unpkg.com">
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="dns-prefetch" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link rel="dns-prefetch" href="https://fonts.gstatic.com">

    <script src="https://cdn.tailwindcss.com"></script>
    <script src="https://unpkg.com/lucide@latest"></script>
    <style>
        @import url('https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800&display=swap');
        /* Themed styles using CSS variables */
        body {
            font-family: 'Inter', -apple-system, BlinkMacSystemFont, 'Segoe UI', sans-serif;
            min-height: 100vh;
            background-color: var(--page-bg); /* Themed background */
            background-attachment: fixed;
            display: flex;
            flex-direction: column;
            color: var(--text-color); /* Themed text color */
            transition: background-color 0.3s ease, color 0.3s ease;
        }

        .main-content-wrapper {
            flex-grow: 1;
            max-width: 1500px;
            margin: 35px auto;
            padding: 35px;
            background: var(--card-bg); /* Themed card background */
            backdrop-filter: blur(10px);
            border-radius: 25px;
            box-shadow: 0 35px 70px var(--shadow-color); /* Themed shadow */
        }

        .search-section {
            background: var(--card-bg); /* Themed background */
            border-radius: 20px;
            padding: 2rem;
            margin-bottom: 2rem;
            box-shadow: 0 12px 25px var(--shadow-color); /* Themed shadow */
            border: 1px solid var(--card-border); /* Themed border */
        }

        .search-container {
            display: flex;
            gap: 18px;
            align-items: stretch;
            flex-wrap: wrap; /* Allow wrapping on smaller screens */
        }

        .search-input-container {
            position: relative;
            flex: 1;
            min-width: 350px;
        }

        .search-input {
            width: 100%;
            padding: 16px 22px 16px 55px;
            font-size: 18px;
            border: 1px solid var(--input-border); /* Themed border */
            border-radius: 16px;
            background: var(--input-bg); /* Themed background */
            color: var(--text-color); /* Themed text */
            transition: all 0.3s ease;
            box-shadow: none;
        }

        .search-input:focus {
            outline: none;
            border-color: var(--input-focus-border); /* Themed border */
            box-shadow: 0 0 0 4px var(--input-focus-shadow); /* Themed shadow */
        }
        .search-input::placeholder {
            color: var(--placeholder-color); /* Themed placeholder */
        }


        .search-input-icon {
            position: absolute;
            left: 20px;
            top: 50%;
            transform: translateY(-50%);
            color: var(--text-color); /* Themed color */
            z-index: 2;
            width: 24px;
            height: 24px;
        }

        .search-controls {
            display: flex;
            gap: 12px;
            flex-wrap: wrap; /* Allow wrapping on smaller screens */
        }

        .search-btn {
            padding: 12px 20px;
            border-radius: 14px;
            border: none;
            cursor: pointer;
            display: flex;
            align-items: center;
            justify-content: center;
            transition: all 0.2s ease;
            font-weight: 600;
            box-shadow: 0 3px 6px var(--shadow-color); /* Themed shadow */
            position: relative;
            overflow: hidden;
            font-size: 1rem;
        }

        .search-btn::before {
            content: '';
            position: absolute;
            top: 0;
            left: -100%;
            width: 100%;
            height: 100%;
            background: linear-gradient(90deg, transparent, rgba(255, 255, 255, 0.5), transparent);
            transition: left 0.4s;
        }

        .search-btn:hover::before {
            left: 100%;
        }

        .search-btn:hover {
            transform: translateY(-1.5px);
            box-shadow: 0 5px 15px var(--shadow-color); /* Stronger themed shadow */
        }

        .search-btn.primary {
            background: var(--admin-blue); /* Themed color */
            color: var(--navbar-text);
        }

        .search-btn.secondary {
            background: var(--primary-green); /* Themed color */
            color: var(--navbar-text);
        }

        .search-btn.tertiary {
            background: var(--dark-bg); /* Themed color */
            color: var(--navbar-text);
        }

        /* Product Grid Changes - Decreased size, fixed 3 items per row on large screens */
        .product-grid {
            grid-template-columns: repeat(3, 1fr);
            gap: 20px;
            margin-top: 2rem;
            display: grid;
        }

        .product-card {
            background: var(--card-bg); /* Themed background */
            border-radius: 14px;
            overflow: hidden;
            transition: all 0.2s ease;
            box-shadow: 0 4px 18px var(--shadow-color); /* Themed shadow */
            border: 1px solid var(--card-border); /* Themed border */
            position: relative;
            cursor: pointer;
        }

        .product-card:hover {
            transform: translateY(-3px);
            box-shadow: 0 8px 25px var(--shadow-color); /* Stronger themed shadow */
        }

        .product-card-image-container {
            width: 100%;
            padding-bottom: 100%;
            position: relative;
            overflow: hidden;
            background: var(--hover-bg-light); /* Light themed background */
            display: flex;
            align-items: center;
            justify-content: center;
        }

        .product-card-image {
            position: absolute;
            top: 0;
            left: 0;
            width: 100%;
            height: 100%;
            object-fit: contain;
            transition: transform 0.2s ease;
        }

        .product-card:hover .product-card-image {
            transform: scale(1.01);
        }

        .product-card-body {
            padding: 20px;
            position: relative;
            z-index: 2;
        }

        .product-card-title {
            font-size: 1.1rem;
            font-weight: 600;
            color: var(--heading-color); /* Themed color */
            margin-bottom: 10px;
            line-height: 1.4;
            background: none;
            -webkit-background-clip: unset;
            -webkit-text-fill-color: initial;
            background-clip: unset;
        }

        .product-card-description {
            display: none;
        }

        .product-card-keywords {
            display: none;
        }

        .product-card-footer {
            padding: 15px 20px;
            background: var(--hover-bg-light); /* Light themed background */
            display: flex;
            justify-content: space-between;
            align-items: center;
            border-top: 1px solid var(--card-border); /* Themed border */
            position: relative;
            z-index: 2;
        }

        .product-price {
            color: var(--primary-green); /* Themed color */
            font-size: 1.2rem;
            font-weight: 700;
            background: none;
            -webkit-background-clip: unset;
            -webkit-text-fill-color: initial;
            background-clip: unset;
        }

        .product-category {
            font-size: 0.75rem;
            color: var(--text-color); /* Themed text color */
            background: var(--card-border); /* Themed background */
            padding: 5px 10px;
            border-radius: 12px;
            font-weight: 500;
            text-transform: uppercase;
            letter-spacing: 1px;
        }

        .loading-grid {
            display: grid;
            grid-template-columns: repeat(3, 1fr);
            gap: 20px;
            margin-top: 2rem;
        }

        .loading-card {
            background: var(--card-bg); /* Themed background */
            border-radius: 14px;
            overflow: hidden;
            height: 360px;
            box-shadow: 0 4px 18px var(--shadow-color); /* Themed shadow */
        }

        .loading-card .skeleton.h-44 {
            padding-bottom: 100%;
            position: relative;
        }
        .loading-card .skeleton.h-44::before {
            content: '';
            position: absolute;
            top: 0;
            left: 0;
            width: 100%;
            height: 100%;
            background: linear-gradient(90deg, var(--card-border) 25%, var(--hover-bg-light) 50%, var(--card-border) 75%); /* Themed gradient */
            background-size: 200% 100%;
            animation: shimmer 2s infinite;
        }
        .loading-card .p-5 { padding: 20px; }

        .loading-card .skeleton.h-6 { height: 1.1rem; }
        .loading-card .skeleton.mb-2 { margin-bottom: 10px; }
        .loading-card .skeleton.h-4 { height: 0.9rem; }
        .loading-card .skeleton.mb-1 { margin-bottom: 6px; }
        .loading-card .skeleton.mb-3 { margin-bottom: 10px; }
        .loading-card .skeleton.h-7 { height: 1.2rem; }
        .loading-card .skeleton.h-6 { height: 1rem; }


        @keyframes shimmer {
            0% {
                background-position: 200% 0;
            }

            100% {
                background-position: -200% 0;
            }
        }

        .no-products-message {
            grid-column: 1 / -1;
            text-align: center;
            padding: 4.5rem 2.5rem;
            color: var(--text-color); /* Themed color */
            font-size: 1.3rem;
            background: var(--card-bg); /* Themed background */
            border-radius: 20px;
            box-shadow: 0 10px 25px var(--shadow-color); /* Themed shadow */
        }

        .search-status {
            text-align: center;
            margin: 1.5rem 0;
            padding: 1.2rem;
            border-radius: 12px;
            background: var(--card-bg); /* Themed background */
            backdrop-filter: blur(8px);
            font-weight: 600;
            font-size: 1.1rem;
            color: var(--text-color); /* Themed color */
        }
        .search-status span {
            color: var(--logout-red); /* Themed error text color */
        }


        .back-to-dashboard-link {
            display: inline-flex;
            align-items: center;
            gap: 10px;
            margin-top: 2.5rem;
            padding: 10px 20px;
            background: var(--dark-bg); /* Themed background */
            color: var(--navbar-text);
            border-radius: 12px;
            font-weight: 600;
            text-decoration: none;
            transition: all 0.2s ease;
            box-shadow: 0 4px 12px var(--shadow-color); /* Themed shadow */
            position: relative;
            overflow: hidden;
            font-size: 0.95rem;
        }

        .back-to-dashboard-link::before {
            content: '';
            position: absolute;
            top: 0;
            left: -100%;
            width: 100%;
            height: 100%;
            background: linear-gradient(90deg, transparent, rgba(255, 255, 255, 0.3), transparent);
            transition: left 0.4s;
        }

        .back-to-dashboard-link:hover::before {
            left: 100%;
        }

        .back-to-dashboard-link:hover {
            transform: translateY(-2px);
            box-shadow: 0 8px 25px var(--shadow-color); /* Stronger themed shadow */
        }

        .icon {
            width: 18px;
            height: 18px;
            stroke: currentColor;
            fill: none;
            stroke-width: 2;
        }

        .spinner {
            animation: spin 1s linear infinite;
        }

        @keyframes spin {
            0% {
                transform: rotate(0deg);
            }

            100% {
                transform: rotate(360deg);
            }
        }

        /* Responsive Adjustments */
        @media (max-width: 1400px) {
            .product-grid {
                grid-template-columns: repeat(3, 1fr);
            }
        }

        @media (max-width: 1024px) {
            .main-content-wrapper {
                margin: 25px;
                padding: 25px;
                border-radius: 20px;
            }
            .product-grid {
                grid-template-columns: repeat(2, 1fr);
                gap: 25px;
                margin-top: 2rem;
            }
            .product-card-image-container {
                height: 180px;
                padding-bottom: 0;
            }
            .product-card-image {
                position: static;
            }
            .loading-card {
                height: auto;
            }
            .loading-card .skeleton.h-44 {
                height: 180px;
                padding-bottom: 0;
            }
        }

        @media (max-width: 768px) {
            .main-content-wrapper {
                margin: 15px;
                padding: 18px;
                border-radius: 15px;
            }
            .search-section {
                padding: 1.5rem;
                margin-bottom: 1.5rem;
                border-radius: 15px;
            }
            /* Make the search input and buttons align in a single row */
            .search-container {
                flex-direction: row;
                flex-wrap: wrap;
                align-items: center;
                gap: 10px;
            }
            .search-input-container {
                min-width: unset;
                flex: 1;
                order: 1;
            }
            .search-input {
                padding: 12px 18px 12px 45px;
                font-size: 16px;
                height: 50px; /* Give it a consistent height */
            }
            .search-input-icon {
                left: 15px;
                width: 20px;
                height: 20px;
            }
            .search-controls {
                gap: 8px;
                order: 2;
                flex-grow: 0;
                flex-shrink: 0;
                justify-content: flex-end;
            }
            .search-btn {
                padding: 12px;
                width: 50px;
                height: 50px;
                font-size: 0;
                border-radius: 14px;
            }
            .search-btn .icon {
                width: 22px;
                height: 22px;
            }
            /* Adjustments for the filter sections */
            .mt-4 {
                margin-top: 1.5rem;
            }
            label.block {
                margin-bottom: 0.5rem;
            }
            .product-grid {
                grid-template-columns: 1fr;
                gap: 20px;
                margin-top: 2rem;
            }
            .product-card-image-container {
                height: 200px;
                padding-bottom: 0;
            }
            .loading-card {
                height: auto;
            }
            .loading-card .skeleton.h-44 {
                height: 200px;
                padding-bottom: 0;
            }
            .product-card-body {
                padding: 20px;
            }
            .product-card-title {
                font-size: 1.2rem;
            }
            .product-price {
                font-size: 1.3rem;
            }
            .product-category {
                font-size: 0.8rem;
            }
            .no-products-message {
                font-size: 1.1rem;
                padding: 3rem 1.5rem;
            }
            .search-status {
                font-size: 0.9rem;
                padding: 1rem;
            }
            .back-to-dashboard-link {
                padding: 8px 15px;
                font-size: 0.85rem;
            }
        }

        @media (max-width: 480px) {
            .search-container {
                flex-direction: column;
                align-items: stretch;
            }
            .search-input-container {
                width: 100%;
                margin-bottom: 10px;
                order: 1;
            }
            .search-controls {
                width: 100%;
                justify-content: space-between;
                order: 2;
            }
            .search-btn {
                flex-grow: 1;
                width: auto;
            }
            .product-card-image-container {
                height: 160px;
            }
            .loading-card .skeleton.h-44 {
                height: 160px;
            }
        }
    </style>
</head>

<body>

    <%- include('partials/navbar') %>

    <div class="main-content-wrapper">
        <div class="search-section">
            <div class="search-container">
                <div class="search-input-container">
                    <input type="text" id="productSearchInput"
                        placeholder="Search for eco-friendly products..."
                        class="search-input">
                    <svg class="search-input-icon icon" xmlns="http://www.w3.org/2000/svg"
                        viewBox="0 0 24 24">
                        <circle cx="11" cy="11" r="8" />
                        <path d="m21 21-4.35-4.35" />
                    </svg>
                </div>
                <div class="search-controls">
                    <button type="button" id="micSearchBtn" class="search-btn primary"
                        title="Voice Search">
                        <svg class="icon" xmlns="http://www.w3.org/2000/svg"
                            viewBox="0 0 24 24">
                            <path d="M12 2a3 3 0 0 0-3 3v7a3 3 0 0 0 6 0V5a3 3 0 0 0-3-3Z" />
                            <path d="M19 10v2a7 7 0 0 1-14 0v-2" />
                            <line x1="12" x2="12" y1="19" y2="22" />
                            <line x1="8" x2="16" y1="22" y2="22" />
                        </svg>
                    </button>
                    <label for="imageSearchInput" class="search-btn secondary"
                        title="Image Search">
                        <svg class="icon" xmlns="http://www.w3.org/2000/svg"
                            viewBox="0 0 24 24">
                            <rect width="18" height="18" x="3" y="3" rx="2" ry="2" />
                            <circle cx="9" cy="9" r="2" />
                            <path d="m21 15-3.086-3.086a2 2 0 0 0-2.828 0L6 21" />
                        </svg>
                        <input type="file" id="imageSearchInput" accept="image/*"
                            class="hidden">
                    </label>
                    <button type="button" id="resetSearchBtn" class="search-btn tertiary"
                        title="Reset Search">
                        <svg class="icon" xmlns="http://www.w3.org/2000/svg"
                            viewBox="0 0 24 24">
                            <path d="M3 12a9 9 0 0 1 9-9 9.75 9.75 0 0 1 6.74 2.74L21 8" />
                            <path d="M21 3v5h-5" />
                            <path d="M21 12a9 9 0 0 1-9 9 9.75 9.75 0 0 1-6.74-2.74L3 16" />
                            <path d="M8 16H3v5" />
                        </svg>
                    </button>
                </div>
            </div>
            <div class="mt-4">
                <label for="ttsLanguageFilter" class="block text-gray-700 text-sm font-bold mb-2">Voice Language:</label>
                <select id="ttsLanguageFilter"
                    class="shadow appearance-none border rounded w-full py-2 px-3 text-gray-700 leading-tight focus:outline-none focus:shadow-outline">
                    <option value="en-US">English (US)</option>
                    <option value="en-GB">English (UK)</option>
                    <option value="hi-IN">Hindi (India)</option>
                    <option value="te-IN">Telugu (India)</option>
                    <option value="es-ES">Spanish (Spain)</option>
                    <option value="fr-FR">French (France)</option>
                    <option value="de-DE">German (Germany)</option>
                    </select>
            </div>

            <div class="mt-4"> <label for="productCategoryFilter"
                    class="block text-gray-700 text-sm font-bold mb-2">Category:</label>
                <select id="productCategoryFilter"
                    class="shadow appearance-none border rounded w-full py-2 px-3 text-gray-700 leading-tight focus:outline-none focus:shadow-outline">
                    <option value="">All Categories</option>
                    <option value="Agriculture & Farming">🌱 Agriculture & Farming</option>
                    <option value="Arts & Handicrafts">🎨 Arts & Handicrafts</option>
                    <option value="Food & Groceries">🍎 Food & Groceries</option>
                    <option value="Retail & Fashion">🛍️ Retail & Fashion</option>
                    <option value="Technology">💻 Technology</option>
                    <option value="Home & Garden">🏡 Home & Garden</option>
                    <option value="Services">🛠️ Services</option>
                    <option value="Other">📦 Other</option>
                </select>
            </div>
        </div>

        <div id="searchStatus" class="search-status"></div>

        <div class="product-grid" id="dynamicProductGrid">
            <div class="loading-grid" id="initialLoadingGrid">
                <% for(let i=0; i < 6; i++) { %>
                <div class="loading-card">
                    <div class="skeleton h-44"></div>
                    <div class="p-5">
                        <div class="skeleton h-6 mb-2 rounded"></div>
                        <div class="skeleton h-4 mb-1 rounded"></div>
                        <div class="skeleton h-4 mb-3 rounded w-3/4"></div>
                        <div class="flex justify-between items-center">
                            <div class="skeleton h-7 w-24 rounded"></div>
                            <div class="skeleton h-6 w-18 rounded-full"></div>
                        </div>
                    </div>
                </div>
                <% } %>
            </div>
        </div>

        <div class="flex justify-center mt-8">
            <button id="loadMoreBtn" class="search-btn primary" style="display: none;">
                <svg class="icon" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24">
                    <path d="M12 5v14M5 12h14" />
                </svg>
                Load More Products
            </button>
        </div>

        <div class="flex justify-center mt-8">
            <a href="/user_dashboard" class="back-to-dashboard-link">
                <svg class="icon" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24">
                    <path d="m12 19-7-7 7-7" />
                    <path d="M19 12H5" />
                </svg>
                <span>Back to Dashboard</span>
            </a>
        </div>
    </div>

    <%- include('partials/footer') %>

    <script>
        document.addEventListener('DOMContentLoaded', () => {
            const productSearchInput = document.getElementById('productSearchInput');
            const productCategoryFilter = document.getElementById('productCategoryFilter');
            const ttsLanguageFilter = document.getElementById('ttsLanguageFilter');
            const micSearchBtn = document.getElementById('micSearchBtn');
            const imageSearchInput = document.getElementById('imageSearchInput');
            const resetSearchBtn = document.getElementById('resetSearchBtn');
            const searchStatus = document.getElementById('searchStatus');
            const dynamicProductGrid = document.getElementById('dynamicProductGrid');
            const initialLoadingGridHtml = dynamicProductGrid.innerHTML;
            const loadMoreBtn = document.getElementById('loadMoreBtn');

            let allLoadedProducts = [];
            const productsPerPage = 12;
            let currentPage = 1;
            let currentSearchQuery = '';
            let currentCategoryFilter = '';
            let totalProductsCount = 0;
            let isLanguageSelected = false; // Flag to ensure products load only after language selection

            // --- Text-to-Speech (TTS) Setup ---
            const synth = window.speechSynthesis;
            const utterThis = new SpeechSynthesisUtterance();
            utterThis.volume = 1;
            utterThis.rate = 1;
            utterThis.pitch = 1;

            // Function to stop speech
            function stopSpeech() {
                if (synth.speaking) {
                    synth.cancel();
                }
            }

            // Function to speak a message, trying to find a voice for the selected language
            function speakMessage(message) {
                stopSpeech(); // Stop any ongoing speech before speaking new message
                utterThis.text = message;

                // Dynamically get voices. Important to do this after voices are loaded.
                const voices = synth.getVoices();
                if (voices.length === 0) {
                    console.warn("No voices available on this system. Cannot speak.");
                    return;
                }

                const selectedLang = ttsLanguageFilter.value;
                let selectedVoice = voices.find(
                    voice => voice.lang === selectedLang || voice.lang.startsWith(selectedLang.split('-')[0])
                );

                if (selectedVoice) {
                    utterThis.voice = selectedVoice;
                    utterThis.lang = selectedVoice.lang; // Ensure utterance lang matches voice
                } else {
                    // Fallback: If no specific voice for the selected language, try generic English.
                    console.warn(`No specific voice found for language ${selectedLang}. Falling back to en-US.`);
                    selectedVoice = voices.find(voice => voice.lang === 'en-US');
                    if (selectedVoice) {
                        utterThis.voice = selectedVoice;
                        utterThis.lang = selectedVoice.lang;
                        // Optional: Could add a small visual/audible cue about language fallback
                    } else {
                        console.error("No en-US or selected language voices available. Cannot speak.");
                        return; // Cannot speak
                    }
                }
                synth.speak(utterThis);
            }

            // NEW: Function to prompt language selection at the very start
            function promptLanguageSelectionOnInit() {
                if (!isLanguageSelected) { // Only prompt if language not yet selected
                    searchStatus.innerHTML = `👋 Please select your preferred voice language from the dropdown above to continue.`;
                    speakMessage("Welcome! Please select your preferred voice language from the dropdown to start Browse products.");
                    // Disable controls until language is selected
                    productSearchInput.disabled = true;
                    micSearchBtn.disabled = true;
                    imageSearchInput.disabled = true;
                    resetSearchBtn.disabled = true;
                    loadMoreBtn.disabled = true; // Ensure load more is disabled
                    dynamicProductGrid.innerHTML = '<div class="no-products-message">Please select a language to load products.</div>';
                    lucide.createIcons();
                }
            }

            // NEW: Handle language selection to enable controls and fetch products
            ttsLanguageFilter.addEventListener('change', () => {
                stopSpeech(); // Stop any ongoing speech
                const selectedText = ttsLanguageFilter.options[ttsLanguageFilter.selectedIndex].text;
                searchStatus.innerHTML = `Language set to ${selectedText}. Loading products...`;
                speakMessage(`Language set to ${selectedText}. Loading products.`);
                isLanguageSelected = true; // Mark language as selected

                // Enable controls
                productSearchInput.disabled = false;
                micSearchBtn.disabled = false;
                imageSearchInput.disabled = false;
                resetSearchBtn.disabled = false;
                
                // Immediately fetch products after language is chosen
                currentPage = 1;
                allLoadedProducts = []; // Clear any previous state
                fetchProducts(currentSearchQuery, currentCategoryFilter, currentPage, productsPerPage, false, ttsLanguageFilter.value); // Pass selected language
            });

            // NEW: Stop speech when navigating away from the page
            window.addEventListener('beforeunload', stopSpeech);


            // Event listener for "Load More" button
            loadMoreBtn.addEventListener('click', () => {
                stopSpeech(); // Stop speech on interaction
                currentPage++;
                fetchProducts(currentSearchQuery, currentCategoryFilter, currentPage, productsPerPage, true, ttsLanguageFilter.value); // Pass selected language
            });
            // Event listener for category filter change
            productCategoryFilter.addEventListener('change', () => {
                stopSpeech(); // Stop speech on interaction
                currentCategoryFilter = productCategoryFilter.value;
                currentPage = 1;
                // Only fetch if language is already selected
                if (isLanguageSelected) {
                    fetchProducts(currentSearchQuery, currentCategoryFilter, currentPage, productsPerPage, false, ttsLanguageFilter.value); // Pass selected language
                }
            });
            /**
             * Renders product cards into the grid.
             * @param {Array} productsToRender - The array of product objects to render.
             * @param {boolean} append - If true, appends products; otherwise, replaces existing ones.
             */
            function renderProducts(productsToRender, append = false) {
                // Only render actual content if language is selected
                if (!isLanguageSelected) return; 

                if (!append) {
                    dynamicProductGrid.innerHTML = '';
                }

                if (productsToRender.length === 0 && allLoadedProducts.length === 0 && !append) {
                    const message = '🔍 No products found matching your criteria. Try adjusting your search terms or filters.';
                    dynamicProductGrid.innerHTML = `<div class="no-products-message">${message}<br><span style="font-size: 0.9rem; margin-top: 0.8rem; display: block; opacity: 0.7;"></span></div>`;
                    loadMoreBtn.style.display = 'none';
                    speakMessage(message);
                    return;
                }

                const fragment = document.createDocumentFragment();
                productsToRender.forEach(product => {
                    const productCard = document.createElement('div');
                    productCard.classList.add('product-card');
                    productCard.innerHTML = `
                        <div class="product-card-image-container">
                            <img src="${product.imageUrl || '/images/default_image.png'}"
                                alt="${product.name || 'Product Image'}"
                                class="product-card-image"
                                onerror="this.src='/images/default_product.png'"
                                loading="lazy">
                        </div>
                        <div class="product-card-body">
                            <h3 class="product-card-title">${product.name || 'Untitled Product'}</h3>
                            <p class="product-card-description">${product.description || 'No description available.'}</p>
                        </div>
                        <div class="product-card-footer">
                            <span class="product-price">$${(parseFloat(product.price) || 0).toFixed(2)}</span>
                            <span class="product-category">${product.category || 'Uncategorized'}</span>
                        </div>
                    `;
                    fragment.appendChild(productCard);
                });
                dynamicProductGrid.appendChild(fragment);

                // --- Automatic Voice Output for Products ---
                // Speak product names only if language is selected and it's not a reset/re-prompt sequence
                if (productsToRender.length > 0 && !append && isLanguageSelected) { 
                    let productNamesToSpeak = productsToRender.slice(0, 3).map(p => p.name).join(', ');
                    if (productsToRender.length > 3) {
                        productNamesToSpeak += `, and ${productsToRender.length - 3} more.`;
                    } else {
                        productNamesToSpeak += '.';
                    }
                    speakMessage(`Found products: ${productNamesToSpeak}`);
                }
                // --- End Automatic Voice Output ---


                // Show/hide load more button based on total products and loaded products
                if (allLoadedProducts.length < totalProductsCount) {
                    loadMoreBtn.style.display = 'block';
                } else {
                    loadMoreBtn.style.display = 'none';
                }

                // Initialize Lucide icons after new elements are added
                lucide.createIcons();
            }

            /**
             * Fetches products from the API.
             * @param {string} query - Search query string.
             * @param {string} category - Category filter string.
             * @param {number} page - Page number for pagination.
             * @param {number} limit - Number of products per page.
             * @param {boolean} append - If true, appends fetched products to existing ones.
             * @param {string} lang - The language code for translation.
             */
            async function fetchProducts(query = '', category = '', page = 1, limit = productsPerPage, append = false, lang = ttsLanguageFilter.value) { // Default lang from dropdown
                // Prevent fetching if language not yet selected
                if (!isLanguageSelected) {
                    return; // Do not fetch products until a language is chosen
                }

                const loadingMessage = 'Loading products...';
                searchStatus.innerHTML = `<svg class="icon spinner inline-block mr-2" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24"><path d="M21 12a9 9 0 1 1-6.219-8.56"/></svg> ${loadingMessage}`;
                loadMoreBtn.disabled = true;
                loadMoreBtn.innerHTML = '<svg class="icon spinner inline-block mr-2" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24"><path d="M21 12a9 9 0 1 1-6.219-8.56"/></svg> Loading...';
                if (!append) {
                    dynamicProductGrid.innerHTML = initialLoadingGridHtml; // Show skeletons while loading
                }

                try {
                    // Pass the selected language to the API
                    const response = await fetch(`/api/products?q=${encodeURIComponent(query)}&category=${encodeURIComponent(category)}&page=${page}&limit=${limit}&lang=${encodeURIComponent(lang)}`);
                    if (!response.ok) {
                        throw new Error(`HTTP error! status: ${response.status}`);
                    }
                    const data = await response.json();
                    totalProductsCount = data.totalProducts;

                    if (append) {
                        allLoadedProducts = allLoadedProducts.concat(data.products);
                    } else {
                        allLoadedProducts = data.products;
                    }

                    renderProducts(data.products, append);
                    const statusText = `Displaying ${allLoadedProducts.length} of ${totalProductsCount} products.`;
                    searchStatus.textContent = statusText;
                } catch (error) {
                    console.error("Failed to fetch products:", error);
                    const errorMessage = 'Failed to load products. Please try again.';
                    searchStatus.innerHTML = `<span style="color: #ef4444;">❌ ${errorMessage}</span>`;
                    dynamicProductGrid.innerHTML = '<div class="no-products-message">Failed to load products. Network error or server issue.</div>';
                    speakMessage(errorMessage);
                } finally {
                    loadMoreBtn.disabled = false;
                    loadMoreBtn.innerHTML = '<svg class="icon" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24"><path d="M12 5v14M5 12h14"/></svg> Load More Products';
                }
            }
            
            // --- Initial Load & Language Prompt Trigger ---
            // On DOMContentLoaded, immediately trigger the language prompt.
            // Ensure voices are loaded first before speaking the prompt.
            if (synth.getVoices().length === 0) {
                synth.onvoiceschanged = promptLanguageSelectionOnInit;
            } else {
                promptLanguageSelectionOnInit();
            }

            let searchTimeout;
            productSearchInput.addEventListener('input', () => {
                clearTimeout(searchTimeout);
                stopSpeech(); // Stop speech on interaction
                searchStatus.textContent = '';
                searchTimeout = setTimeout(() => {
                    currentSearchQuery = productSearchInput.value.trim();
                    currentPage = 1;
                    if (isLanguageSelected) { // Only fetch if language already selected
                        fetchProducts(currentSearchQuery, currentCategoryFilter, currentPage, productsPerPage, false, ttsLanguageFilter.value); // Pass selected language
                    }
                }, 300);
            });
            // Speech Recognition (Voice Search)
            const SpeechRecognition = window.SpeechRecognition || window.webkitSpeechRecognition;
            if (SpeechRecognition) {
                const recognition = new SpeechRecognition();
                recognition.continuous = false;
                // Set initial recognition language, will update on dropdown change
                recognition.lang = ttsLanguageFilter.value;
                // Update recognition language when TTS language changes (if applicable)
                ttsLanguageFilter.addEventListener('change', () => {
                    recognition.lang = ttsLanguageFilter.value;
                });
                micSearchBtn.addEventListener('click', () => {
                    if (!isLanguageSelected) { // Prevent voice search if language not chosen
                        searchStatus.innerHTML = `<span style="color: red;">Please select a language first to use voice search.</span>`;
                        speakMessage("Please select your preferred voice language first.");
                        return;
                    }
                    stopSpeech(); // Stop speech on interaction
                    micSearchBtn.innerHTML = '<svg class="icon spinner" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24"><path d="M21 12a9 9 0 1 1-6.219-8.56"/></svg>';
                    const listeningMessage = 'Listening... Speak now.';
                    searchStatus.innerHTML = `🎤 ${listeningMessage}`;
                    speakMessage(listeningMessage);
                    try {
                        recognition.start();
                    } catch (e) {
                        console.error("Speech recognition start error:", e);
                        const errorMessage = 'Microphone error. Please allow access.';
                        searchStatus.innerHTML = `<span style="color: #ef4444;">❌ ${errorMessage}</span>`;
                        speakMessage(errorMessage);
                        resetMicButton();
                    }
                });
                recognition.onresult = (event) => {
                    const transcript = event.results[0][0].transcript;
                    productSearchInput.value = transcript;
                    const transcribedMessage = `Transcribed: "${transcript}"`;
                    searchStatus.innerHTML = `✨ ${transcribedMessage}`;
                    speakMessage(transcribedMessage);
                    currentSearchQuery = transcript;
                    currentPage = 1;
                    fetchProducts(currentSearchQuery, currentCategoryFilter, currentPage, productsPerPage, false, ttsLanguageFilter.value); // Pass selected language
                };

                recognition.onerror = (event) => {
                    const errorMessage = `Voice search error: ${event.error}`;
                    searchStatus.innerHTML = `<span style="color: #ef4444;">❌ ${errorMessage}</span>`;
                    console.error('Speech recognition error:', event.error);
                    speakMessage(errorMessage);
                    resetMicButton();
                };
                recognition.onend = () => {
                    resetMicButton();
                    if (searchStatus.textContent.includes('Listening')) {
                        const noSpeechMessage = 'No speech detected. Please try again.';
                        searchStatus.innerHTML = `🔇 ${noSpeechMessage}`;
                        speakMessage(noSpeechMessage);
                    }
                };
                function resetMicButton() {
                    micSearchBtn.innerHTML = '<svg class="icon" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24"><path d="M12 2a3 3 0 0 0-3 3v7a3 3 0 0 0 6 0V5a3 3 0 0 0-3-3Z"/><path d="M19 10v2a7 7 0 0 1-14 0v-2"/><line x1="12" x2="12" y1="19" y2="22"/><line x1="8" x2="16" y1="22" y2="22"/></svg>';
                }
            } else {
                micSearchBtn.disabled = true;
                micSearchBtn.style.opacity = '0.5';
                const notSupportedMessage = 'Voice search not supported in this browser.';
                searchStatus.innerHTML = `⚠️ ${notSupportedMessage}`;
            }

            // Image Search
            imageSearchInput.addEventListener('change', async (event) => {
                const file = event.target.files[0];
                if (!file) {
                    searchStatus.textContent = '';
                    return;
                }

                stopSpeech(); // Stop speech on interaction

                const allowedTypes = ['image/jpeg', 'image/jpg', 'image/png', 'image/gif'];
                const maxSize = 5 * 1024 * 1024; // 5MB

                if (!allowedTypes.includes(file.type) || file.size > maxSize) {
                    const validationError = 'Invalid image format or size (JPG/PNG/GIF, max 5MB).';
                    searchStatus.innerHTML = `<span style="color: #ef4444;">❌ ${validationError}</span>`;
                    speakMessage(validationError);
                    event.target.value = '';
                    return;
                }

                if (!isLanguageSelected) { // Prevent image search if language not chosen
                    searchStatus.innerHTML = `<span style="color: red;">Please select a language first to use image search.</span>`;
                    speakMessage("Please select your preferred voice language first.");
                    return;
                }

                const analyzingMessage = 'Analyzing image...';
                searchStatus.innerHTML = `<svg class="icon spinner inline-block mr-2" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24"><path d="M21 12a9 9 0 1 1-6.219-8.56"/></svg> 🔍 ${analyzingMessage}`;
                speakMessage(analyzingMessage);

                const formData = new FormData();
                formData.append('image', file);
                formData.append('query', productSearchInput.value.trim());
                try {
                    const response = await fetch('/api/search-by-image', {
                        method: 'POST',
                        body: formData
                    });
                    const result = await response.json();

                    if (response.ok) {
                        const searchKeywords = Array.isArray(result.keywords) ? result.keywords.join(', ') : result.query || '';
                        productSearchInput.value = searchKeywords;
                        const imageAnalysisMessage = `Image analysis complete. Searching for: "${searchKeywords}"`;
                        searchStatus.innerHTML = `✨ ${imageAnalysisMessage}`;
                        speakMessage(imageAnalysisMessage);
                        currentSearchQuery = searchKeywords;
                        currentPage = 1;
                        fetchProducts(currentSearchQuery, currentCategoryFilter, currentPage, productsPerPage, false, ttsLanguageFilter.value); // Pass selected language
                    } else {
                        const errorMessage = `Error analyzing image: ${result.message || 'Unknown error'}.`;
                        searchStatus.innerHTML = `<span style="color: #ef4444;">❌ ${errorMessage}</span>`;
                        speakMessage(errorMessage);
                    }
                } catch (error) {
                    console.error('Image search API error:', error);
                    const networkError = 'Network error analyzing image';
                    searchStatus.innerHTML = `<span style="color: #ef4444;">❌ ${networkError}</span>`;
                    speakMessage(networkError);
                } finally {
                    event.target.value = '';
                }
            });

            // Reset Search Button
            resetSearchBtn.addEventListener('click', () => {
                stopSpeech(); // Stop speech on interaction
                productSearchInput.value = '';
                productCategoryFilter.value = '';
                searchStatus.textContent = '';
                currentSearchQuery = '';
                currentCategoryFilter = '';
                currentPage = 1;
                allLoadedProducts = [];
                // Clear the status and ensure the prompt appears again.
                searchStatus.innerHTML = '';
                isLanguageSelected = false; // Reset flag
                
                // Disable controls during reset state
                productSearchInput.disabled = true;
                micSearchBtn.disabled = true;
                imageSearchInput.disabled = true;
                resetSearchBtn.disabled = true;
                loadMoreBtn.disabled = true;
                dynamicProductGrid.innerHTML = '<div class="no-products-message">Please select a language to load products.</div>';
                
                promptLanguageSelectionOnInit(); // Re-prompt language after reset
            });
        });
    </script>
</body>

</html>