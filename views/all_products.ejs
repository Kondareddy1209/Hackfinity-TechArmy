<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>All Products • MyGreenHome</title>
    <script src="https://cdn.tailwindcss.com"></script>
    <script src="https://unpkg.com/lucide@latest"></script>
    <style>
        body {
            font-family: 'Inter', sans-serif;
        }
        .product-grid {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
            gap: 24px;
        }
        .product-card {
            background-color: #fff;
            border-radius: 12px;
            box-shadow: 0 4px 15px rgba(0, 0, 0, 0.08);
            overflow: hidden;
            transition: transform 0.2s ease-in-out, box-shadow 0.2s ease-in-out;
            display: flex;
            flex-direction: column;
        }
        .product-card:hover {
            transform: translateY(-5px);
            box-shadow: 0 8px 25px rgba(0, 0, 0, 0.15);
        }
        .product-card-image-container {
            width: 100%;
            height: 200px; /* Fixed height for consistency */
            overflow: hidden;
            display: flex;
            justify-content: center;
            align-items: center;
            background-color: #f0f0f0;
        }
        .product-card-image {
            width: 100%;
            height: 100%;
            object-fit: cover; /* Ensures image covers the area */
        }
        .product-card-body {
            padding: 16px;
            flex-grow: 1;
            display: flex;
            flex-direction: column;
        }
        .product-card-body h3 {
            font-weight: 700;
            color: #2c3e50;
            font-size: 1.5rem;
            margin-bottom: 8px;
        }
        .product-card-body p {
            font-size: 0.95rem;
            color: #4b5563;
            line-height: 1.5;
            margin-bottom: 12px;
        }
        .product-card-footer {
            padding: 16px;
            background-color: #f9fafb;
            border-top: 1px solid #e5e7eb;
            display: flex;
            justify-content: space-between;
            align-items: center;
        }
        .product-card-footer .price {
            font-size: 1.2rem;
            font-weight: 700;
            color: #22c55e; /* green-500 */
        }
        .product-card-footer .category {
            font-size: 0.85rem;
            color: #6b7280;
            background-color: #e5e7eb;
            padding: 4px 8px;
            border-radius: 6px;
        }
        .no-products-message {
            text-align: center;
            padding: 40px;
            font-style: italic;
            color: #6b7280;
            font-size: 1.1rem;
        }
        .back-to-dashboard-link {
            display: inline-flex;
            align-items: center;
            gap: 8px;
            margin-top: 40px;
            padding: 12px 24px;
            background-color: #6b7280; /* gray-500 */
            color: white;
            border-radius: 8px;
            font-weight: 600;
            text-decoration: none;
            transition: background-color 0.2s ease, transform 0.2s ease;
        }
        .back-to-dashboard-link:hover {
            background-color: #4b5563; /* gray-600 */
            transform: translateY(-2px);
        }
    </style>
</head>
<body class="bg-gray-100 text-gray-900 font-sans min-h-screen flex flex-col justify-between">

    <!-- Include the navbar partial -->
    <%- include('partials/navbar') %>

    <!-- Main Content Area -->
    <div class="flex-grow p-6 max-w-6xl mx-auto w-full">
        <h2 class="text-3xl font-bold text-center text-green-700 mb-8 mt-4">All Products in Catalog</h2>
        <p class="text-center text-lg text-gray-600 mb-10">Browse products available from various sources.</p>

        <% if (products && products.length > 0) { %>
            <div class="product-grid">
                <% products.forEach(product => { %>
                    <div class="product-card">
                        <div class="product-card-image-container">
                            <img src="<%= product.imageUrl || '/images/default_product.png' %>" alt="<%= product.name %>" class="product-card-image">
                        </div>
                        <div class="product-card-body">
                            <h3 class="text-xl"><%= product.name %></h3>
                            <p><%= product.description %></p>
                            <% if (product.keywords && product.keywords.length > 0) { %>
                                <p class="text-sm text-gray-500 mt-auto">Keywords: <%= product.keywords.join(', ') %></p>
                            <% } %>
                        </div>
                        <div class="product-card-footer">
                            <span class="price">$<%= product.price.toFixed(2) %></span>
                            <span class="category"><%= product.category %></span>
                        </div>
                    </div>
                <% }); %>
            </div>
        <% } else { %>
            <div class="no-products-message">
                <p>No products found in the general catalog yet.</p>
                <p>Admins can add products via their dashboard.</p>
            </div>
        <% } %>

        <div class="flex justify-center">
            <a href="/user_dashboard" class="back-to-dashboard-link">
                <i data-lucide="arrow-left" class="w-5 h-5"></i> Back to Dashboard
            </a>
        </div>
    </div>

    <!-- Include the footer partial -->
    <%- include('partials/footer') %>

    <script>
        // Initialize Lucide icons after the DOM is loaded
        document.addEventListener('DOMContentLoaded', () => {
            lucide.createIcons();
        });
    </script>
</body>
</html>
