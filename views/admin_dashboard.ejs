<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Admin Dashboard • Agent Seller</title>
    <script src="https://cdn.tailwindcss.com"></script>
    <script src="https://unpkg.com/lucide@latest"></script>
    <style>
        /* Custom styles for Admin Dashboard */
        body {
            font-family: 'Inter', sans-serif;
        }

        .stat-card {
            transition: transform 0.2s ease-in-out, box-shadow 0.2s ease-in-out;
        }

        .stat-card:hover {
            transform: translateY(-5px);
            box-shadow: 0 15px 30px rgba(0, 0, 0, 0.15);
        }

        .action-btn {
            transition: all 0.2s ease-in-out;
        }

        .action-btn:hover {
            transform: translateY(-2px);
            box-shadow: 0 8px 16px rgba(0, 0, 0, 0.2);
        }

        .user-list-item {
            transition: all 0.2s ease-in-out;
        }

        .user-list-item:hover {
            background-color: #f0fdf4;
            transform: translateX(5px);
        }

        .dashboard-section {
            margin-bottom: 2rem;
        }

        /* --- Voice Search Specific Styles (copied from user_dashboard for consistency) --- */
        .search-controls-dashboard {
            display: flex;
            align-items: center;
            gap: 12px;
            margin-bottom: 2rem;
            justify-content: center;
            margin-top: 1rem; /* Added margin-top to separate from header */
        }

        .mic-search-btn-dashboard {
            padding: 14px;
            border-radius: 16px;
            border: none;
            cursor: pointer;
            display: flex;
            align-items: center;
            justify-content: center;
            transition: all 0.2s ease;
            font-weight: 600;
            box-shadow: 0 4px 8px rgba(0, 0, 0, 0.15);
            position: relative;
            overflow: hidden;
            background: #3b82f6; /* Primary color */
            color: white;
        }
        .mic-search-btn-dashboard::before {
            content: '';
            position: absolute;
            top: 0;
            left: -100%;
            width: 100%;
            height: 100%;
            background: linear-gradient(90deg, transparent, rgba(255, 255, 255, 0.3), transparent);
            transition: left 0.4s;
        }
        .mic-search-btn-dashboard:hover::before {
            left: 100%;
        }
        .mic-search-btn-dashboard:hover {
            transform: translateY(-1.5px);
            box-shadow: 0 6px 18px rgba(0, 0, 0, 0.2);
        }

        .icon { /* Generic icon style, used by Lucide */
            width: 24px;
            height: 24px;
            stroke: currentColor;
            fill: none;
            stroke-width: 2;
        }
        .spinner {
            animation: spin 1s linear infinite;
        }
        @keyframes spin {
            0% { transform: rotate(0deg); }
            100% { transform: rotate(360deg); }
        }

        .voice-search-status-dashboard {
            text-align: center;
            margin-top: 1rem;
            padding: 0.8rem;
            border-radius: 8px;
            background: rgba(255, 255, 255, 0.9);
            backdrop-filter: blur(5px);
            font-weight: 500;
            font-size: 0.9rem;
            color: #4a5568;
            max-width: 400px;
            margin-left: auto;
            margin-right: auto;
        }
        /* --- End Voice Search Specific Styles --- */


        /* Mobile-specific improvements */
        @media (max-width: 640px) {
            .stat-card {
                padding: 1.5rem !important;
            }
            
            .action-btn {
                padding: 1rem !important;
            }
            
            .user-list-item {
                padding: 0.75rem !important;
            }
            
            .user-list-item:hover {
                transform: none;
            }
        }

        /* Tablet improvements */
        @media (max-width: 1024px) {
            .stat-card:hover {
                transform: translateY(-2px);
            }
            
            .action-btn:hover {
                transform: translateY(-1px);
            }
        }
    </style>
</head>

<body class="bg-gradient-to-br from-gray-50 to-blue-50 text-gray-900 font-sans min-h-screen">

    <%- include('partials/navbar') %>

    <div class="container mx-auto px-3 sm:px-4 lg:px-6 py-4 sm:py-6 max-w-7xl">
        
        <div class="dashboard-section text-center mb-8 sm:mb-12">
            <div class="inline-flex items-center justify-center w-16 h-16 sm:w-20 sm:h-20 bg-blue-100 rounded-full mb-3 sm:mb-4">
                <i data-lucide="crown" class="w-8 h-8 sm:w-10 sm:h-10 text-blue-600"></i>
            </div>
            <h1 class="text-2xl sm:text-3xl lg:text-4xl font-bold text-gray-800 mb-2 px-4">Admin Dashboard</h1>
            <p class="text-base sm:text-lg lg:text-xl text-gray-600 max-w-2xl mx-auto px-4">
                Complete overview and management tools for Agent Seller platform
            </p>
        </div>

        <div class="flex flex-col items-center">
            <div class="search-controls-dashboard">
                <button type="button" id="micSearchBtnDashboard" class="mic-search-btn-dashboard"
                    title="Voice Search for Products">
                    <i data-lucide="mic" class="icon"></i>
                    <span class="ml-2">Voice Search Products</span>
                </button>
            </div>
            <div id="voiceSearchStatus" class="voice-search-status-dashboard" style="display: none;"></div>
        </div>
        <div class="dashboard-section">
            <h2 class="text-xl sm:text-2xl font-bold text-gray-700 mb-4 sm:mb-6 text-center px-4">Platform Statistics</h2>
            <div class="grid grid-cols-1 sm:grid-cols-2 xl:grid-cols-2 gap-6 sm:gap-8 lg:gap-10"> 
                <div class="stat-card bg-white shadow-lg rounded-xl sm:rounded-2xl p-6 sm:p-8 text-center border border-gray-100">
                    <div class="inline-flex items-center justify-center w-12 h-12 sm:w-16 sm:h-16 bg-blue-100 rounded-full mb-3 sm:mb-4">
                        <i data-lucide="users" class="w-6 h-6 sm:w-8 sm:h-8 text-blue-600"></i>
                    </div>
                    <h4 class="text-base sm:text-lg font-semibold text-gray-700 mb-2">Total Users</h4>
                    <p class="text-2xl sm:text-3xl lg:text-4xl font-bold text-blue-800 mb-2">
                        <%= totalUsers %>
                    </p>
                    <p class="text-xs sm:text-sm text-gray-500">Registered members</p>
                </div>
                
                <div class="stat-card bg-white shadow-lg rounded-xl sm:rounded-2xl p-6 sm:p-8 text-center border border-gray-100">
                    <div class="inline-flex items-center justify-center w-12 h-12 sm:w-16 sm:h-16 bg-purple-100 rounded-full mb-3 sm:mb-4">
                        <i data-lucide="shield" class="w-6 h-6 sm:w-8 sm:h-8 text-purple-600"></i>
                    </div>
                    <h4 class="text-base sm:text-lg font-semibold text-gray-700 mb-2">Admin Accounts</h4>
                    <p class="text-2xl sm:text-3xl lg:text-4xl font-bold text-purple-800 mb-2">
                        <%= adminUsers %>
                    </p>
                    <p class="text-xs sm:text-sm text-gray-500">Administrative users</p>
                </div>
                
                </div>
        </div>

        <div class="dashboard-section">
            <h2 class="text-xl sm:text-2xl font-bold text-gray-700 mb-4 sm:mb-6 text-center px-4">Quick Actions</h2>
            <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-3 sm:gap-4">
                <a href="/admin/users" class="action-btn bg-blue-600 text-white p-4 sm:p-6 rounded-xl font-semibold text-center hover:bg-blue-700 group">
                    <div class="inline-flex items-center justify-center w-10 h-10 sm:w-12 sm:h-12 bg-blue-500 rounded-lg mb-2 sm:mb-3 group-hover:bg-blue-400">
                        <i data-lucide="user-cog" class="w-5 h-5 sm:w-6 sm:h-6"></i>
                    </div>
                    <div class="text-base sm:text-lg font-semibold">Manage Users</div>
                    <div class="text-xs sm:text-sm opacity-90">View and edit users</div>
                </a>
                
                <a href="/admin/products/add" class="action-btn bg-green-600 text-white p-4 sm:p-6 rounded-xl font-semibold text-center hover:bg-green-700 group">
                    <div class="inline-flex items-center justify-center w-10 h-10 sm:w-12 sm:h-12 bg-green-500 rounded-lg mb-2 sm:mb-3 group-hover:bg-green-400">
                        <i data-lucide="plus-circle" class="w-5 h-5 sm:w-6 sm:h-6"></i>
                    </div>
                    <div class="text-base sm:text-lg font-semibold">Add Product</div>
                    <div class="text-xs sm:text-sm opacity-90">Admin products</div>
                </a>
                
                <a href="/user/listings/add" class="action-btn bg-purple-600 text-white p-4 sm:p-6 rounded-xl font-semibold text-center hover:bg-purple-700 group">
                    <div class="inline-flex items-center justify-center w-10 h-10 sm:w-12 sm:h-12 bg-purple-500 rounded-lg mb-2 sm:mb-3 group-hover:bg-purple-400">
                        <i data-lucide="package-plus" class="w-5 h-5 sm:w-6 sm:h-6"></i>
                    </div>
                    <div class="text-base sm:text-lg font-semibold">Add Listing</div>
                    <div class="text-xs sm:text-sm opacity-90">Public listings</div>
                </a>
                
                <a href="/user_dashboard" class="action-btn bg-gray-600 text-white p-4 sm:p-6 rounded-xl font-semibold text-center hover:bg-gray-700 group">
                    <div class="inline-flex items-center justify-center w-10 h-10 sm:w-12 sm:h-12 bg-gray-500 rounded-lg mb-2 sm:mb-3 group-hover:bg-gray-400">
                        <i data-lucide="arrow-left" class="w-5 h-5 sm:w-6 sm:h-6"></i>
                    </div>
                    <div class="text-base sm:text-lg font-semibold">User View</div>
                    <div class="text-xs sm:text-sm opacity-90">Switch to user</div>
                </a>
            </div>
        </div>

        <div class="dashboard-section">
            <div class="bg-white shadow-lg rounded-xl sm:rounded-2xl border border-gray-100 overflow-hidden">
                <div class="bg-gradient-to-r from-blue-50 to-purple-50 px-4 sm:px-6 lg:px-8 py-4 sm:py-6 border-b border-gray-100">
                    <div class="flex items-center space-x-3">
                        <div class="inline-flex items-center justify-center w-8 h-8 sm:w-10 sm:h-10 bg-blue-100 rounded-full">
                            <i data-lucide="user-plus" class="w-4 h-4 sm:w-5 sm:h-5 text-blue-600"></i>
                        </div>
                        <h3 class="text-xl sm:text-2xl font-bold text-gray-800">Recent Signups</h3>
                    </div>
                </div>
                
                <div class="p-3 sm:p-4 lg:p-6">
                    <% if (recentSignups && recentSignups.length > 0) { %>
                        <div class="space-y-3 sm:space-y-4">
                            <% recentSignups.forEach((signup, index) => { %>
                                <div class="user-list-item flex flex-col sm:flex-row sm:items-center justify-between p-3 sm:p-4 rounded-lg sm:rounded-xl border border-gray-100 hover:border-green-200 space-y-3 sm:space-y-0">
                                    <div class="flex items-center space-x-3 sm:space-x-4">
                                        <div class="relative flex-shrink-0">
                                            <img src="<%= signup.profilePicture || '/images/default_image.png' %>" 
                                                 alt="Profile" 
                                                 class="w-10 h-10 sm:w-12 sm:h-12 lg:w-14 lg:h-14 rounded-full object-cover border-2 border-gray-200">
                                            <div class="absolute -top-1 -right-1 w-4 h-4 sm:w-5 sm:h-5 bg-green-500 rounded-full border-2 border-white flex items-center justify-center">
                                                <span class="text-xs text-white font-bold"><%= index + 1 %></span>
                                            </div>
                                        </div>
                                        <div class="min-w-0 flex-1">
                                            <div class="text-sm sm:text-base lg:text-lg font-semibold text-gray-800 truncate">
                                                <%= signup.firstName || 'Unknown' %> <%= signup.lastName || 'User' %>
                                            </div>
                                            <div class="text-xs sm:text-sm text-gray-600 flex items-center space-x-1 sm:space-x-2">
                                                <i data-lucide="mail" class="w-3 h-3 sm:w-4 sm:h-4 flex-shrink-0"></i>
                                                <span class="truncate"><%= signup.email %></span>
                                            </div>
                                        </div>
                                    </div>
                                    <div class="text-right sm:text-left sm:pl-4">
                                        <div class="text-xs sm:text-sm font-medium text-gray-700">Joined</div>
                                        <div class="text-xs sm:text-sm text-gray-500 flex items-center space-x-1 justify-end sm:justify-start">
                                            <i data-lucide="calendar" class="w-3 h-3 sm:w-4 sm:h-4"></i>
                                            <span><%= new Date(signup.createdAt).toLocaleDateString() %></span>
                                        </div>
                                    </div>
                                </div>
                            <% }); %>
                        </div>
                    <% } else { %>
                        <div class="text-center py-8 sm:py-12">
                            <div class="inline-flex items-center justify-center w-12 h-12 sm:w-16 sm:h-16 bg-gray-100 rounded-full mb-3 sm:mb-4">
                                <i data-lucide="users" class="w-6 h-6 sm:w-8 sm:h-8 text-gray-400"></i>
                            </div>
                            <h4 class="text-base sm:text-lg font-semibold text-gray-600 mb-2">No Recent Signups</h4>
                            <p class="text-sm sm:text-base text-gray-500 px-4">New user registrations will appear here</p>
                        </div>
                    <% } %>
                </div>
            </div>
        </div>

    </div>

    <%- include('partials/footer') %>

    <script>
        document.addEventListener('DOMContentLoaded', () => {
            lucide.createIcons();

            const micSearchBtnDashboard = document.getElementById('micSearchBtnDashboard');
            const voiceSearchStatus = document.getElementById('voiceSearchStatus');

            // --- Speech Recognition (Voice Search) ---
            const SpeechRecognition = window.SpeechRecognition || window.webkitSpeechRecognition;

            if (SpeechRecognition) {
                const recognition = new SpeechRecognition();
                recognition.continuous = false;
                recognition.lang = 'en-US'; // Default to English for admin dashboard voice search
                recognition.interimResults = false;

                micSearchBtnDashboard.addEventListener('click', () => {
                    voiceSearchStatus.style.display = 'block';
                    voiceSearchStatus.innerHTML = '<i data-lucide="mic" class="icon spinner inline-block mr-2"></i> Listening... Speak now.';
                    lucide.createIcons();
                    try {
                        recognition.start();
                    } catch (e) {
                        console.error("Speech recognition start error:", e);
                        voiceSearchStatus.innerHTML = '<span style="color: #ef4444;">❌ Microphone error. Please allow access.</span>';
                        resetMicButton();
                    }
                });

                recognition.onresult = (event) => {
                    const transcript = event.results[0][0].transcript;
                    voiceSearchStatus.innerHTML = `✨ Transcribed: "${transcript}". Redirecting...`;
                    // Redirect to all-products page with the search query
                    window.location.href = `/user/all-products?q=${encodeURIComponent(transcript)}`;
                };

                recognition.onerror = (event) => {
                    voiceSearchStatus.innerHTML = `<span style="color: #ef4444;">❌ Voice search error: ${event.error}</span>`;
                    console.error('Speech recognition error:', event.error);
                    resetMicButton();
                };

                recognition.onend = () => {
                    resetMicButton();
                    if (voiceSearchStatus.innerHTML.includes('Listening')) {
                        voiceSearchStatus.innerHTML = '🔇 No speech detected. Please try again.';
                    }
                    setTimeout(() => {
                        if (!voiceSearchStatus.innerHTML.includes('Redirecting')) {
                            voiceSearchStatus.style.display = 'none';
                        }
                    }, 3000);
                };

                function resetMicButton() {
                    micSearchBtnDashboard.innerHTML = '<i data-lucide="mic" class="icon"></i> <span class="ml-2">Voice Search Products</span>';
                    lucide.createIcons();
                }
            } else {
                micSearchBtnDashboard.disabled = true;
                micSearchBtnDashboard.style.opacity = '0.5';
                micSearchBtnDashboard.innerHTML = '<i data-lucide="mic-off" class="icon"></i> <span class="ml-2">Voice Search Disabled</span>';
                voiceSearchStatus.style.display = 'block';
                voiceSearchStatus.innerHTML = '⚠️ Voice search not supported in this browser.';
                lucide.createIcons();
            }
        });
    </script>
</body>

</html>