</nav>
<div id="mySideMenu" class="side-menu">
    <a href="javascript:void(0)" class="close-btn" id="closeMenu">&times;</a>
    <% if (typeof user !=='undefined' && user) { %>
        <div class="navbar-user-info mobile-view">
            <a href="/dashboard/profile" class="mobile-profile-link">
                <img src="<%= user.profilePicture || '/images/default_image.png' %>" alt="Profile">
                <span>
                    <%= user.firstName || user.username %>
                </span>
            </a>
            <div class="navbar-points">
                <i class="fas fa-star"></i>
                <%= user.points || 0 %>
            </div>
        </div>
        <a href="/">Home</a>
        <% if (user.role==='admin' ) { %>
            <a href="/dashboard">Admin Dashboard</a>
            <a href="/admin/users">Manage Users</a>
            <a href="/admin/products/add">Add Admin Product</a>
            <a href="/user/all-products">View All Products</a>
            <% } else { %>
                <a href="/user_dashboard">Dashboard</a>
                <a href="/user/product-generator">Product Generator</a>
                <a href="/user/my-catalog">My Catalog</a>
                <a href="/user/all-products">All Products</a>
                <% } %>
                    <a href="/dashboard/profile">Profile</a>
                    <a href="/ai-chat">AI Chat</a>
                    <a href="/team">Our Team</a>
                    <a href="/auth/logout" class="mobile-action-btn mobile-logout-btn"><i
                            class="fas fa-right-from-bracket"></i> Logout</a>
                    <% } else { %>
                        <a href="/">Home</a>
                        <a href="/auth/login" class="mobile-action-btn mobile-login-btn">Login</a>
                        <a href="/auth/signup" class="mobile-action-btn">Sign Up</a>
                        <a href="/admin/login" class="mobile-action-btn mobile-admin-login-btn">Admin Login</a>
                        <a href="/team">Our Team</a>
                        <% } %>
                            <button id="themeToggleMobile" class="mobile-action-btn" title="Toggle Theme (Light/Dark)"
                                style="background-color: var(--admin-blue);">
                                <i class="fas fa-moon"></i> Toggle Theme
                            </button>
</div>
<script>
    document.getElementById("menuToggle").addEventListener("click", function () {
        document.getElementById("mySideMenu").style.width = "250px";
        document.body.classList.add('no-scroll');
    });
    document.getElementById("closeMenu").addEventListener("click", function () {
        document.getElementById("mySideMenu").style.width = "0";
        document.body.classList.remove('no-scroll');
    });
    document.querySelectorAll("#mySideMenu a").forEach(link => {
        link.addEventListener("click", function () {
            if (!link.classList.contains('close-btn') && !link.hasAttribute('target')) {
                document.getElementById("mySideMenu").style.width = "0";
                document.body.classList.remove('no-scroll');
            }
        });
    });
    const themeToggle = document.getElementById('themeToggle');
    const themeToggleMobile = document.getElementById('themeToggleMobile');
    const body = document.body;
    const lightIcon = '<i class="fas fa-sun"></i>';
    const darkIcon = '<i class="fas fa-moon"></i>';
    function applyTheme(theme) {
        if (theme === 'dark') {
            body.classList.add('dark-mode');
            themeToggle.innerHTML = lightIcon;
            themeToggleMobile.innerHTML = lightIcon + ' Toggle Theme';
            localStorage.setItem('theme', 'dark');
        } else {
            body.classList.remove('dark-mode');
            themeToggle.innerHTML = darkIcon;
            themeToggleMobile.innerHTML = darkIcon + ' Toggle Theme';
            localStorage.setItem('theme', 'light');
        }
    }
    document.addEventListener('DOMContentLoaded', () => {
        const savedTheme = localStorage.getItem('theme') || 'light';
        applyTheme(savedTheme);
    });
    themeToggle.addEventListener('click', () => {
        const currentTheme = body.classList.contains('dark-mode') ? 'dark' : 'light';
        applyTheme(currentTheme === 'light' ? 'dark' : 'light');
    });
    themeToggleMobile.addEventListener('click', () => {
        const currentTheme = body.classList.contains('dark-mode') ? 'dark' : 'light';
        applyTheme(currentTheme === 'light' ? 'dark' : 'light');
    });
</script>