<style>
    /* -------------------------------------- */
    /* CSS Variables for Theming - Light Mode (Default) */
    /* -------------------------------------- */
    :root {
        --page-bg: #f4f7f6;
        /* Global background */
        --text-color: #333;
        /* Default text color */
        --text-secondary-color: #6b7280;
        /* Secondary text color */
        --heading-color: #2c3e50;
        /* Headings */
        --card-bg: white;
        /* Background for cards, forms, sections */
        --card-border: #e5e7eb;
        /* Borders for cards, inputs */
        --shadow-color: rgba(0, 0, 0, 0.1);
        /* Subtle shadows */
        --hover-bg-light: #f1f1f1;
        /* Light hover for general elements */

        --primary-green: #4CAF50;
        --hover-green: #5cb85c;
        --navbar-bg: var(--primary-green);
        --navbar-text: white;

        --logout-red: #d9534f;
        --logout-red-hover: #c9302c;
        --points-orange: #f39c12;

        --admin-blue: #4A90E2;
        --admin-blue-hover: #357ab8;
        --login-blue: #007bff;
        --login-blue-hover: #0056b3;

        --input-bg: rgba(255, 255, 255, 0.8);
        --input-border: #ccc;
        --input-focus-border: #3b82f6;
        --input-focus-shadow: rgba(59, 130, 246, 0.25);
        --placeholder-color: #9ca3af;

        --table-header-bg: #f3f4f6;
        --table-row-even-bg: #f9fafb;
        --table-hover-bg: #e0f2f7;
        --table-border-color: #ddd;

        --status-success-bg: #d4edda;
        --status-success-color: #155724;
        --status-error-bg: #f8d7da;
        --status-error-color: #721c24;
        --status-info-bg: #e0f2fe;
        --status-info-color: #1e40af;

        /* Side Menu Variables - Light Mode */
        --side-menu-bg: #ffffff;
        --side-menu-text: #000000;
        --side-menu-border: #e0e0e0;
        --side-menu-hover-bg: #f5f5f5;
        --side-menu-header-bg: #f9f9f9;
        --side-menu-header-border: #ddd;
    }

    /* -------------------------------------- */
    /* Dark Theme Overrides */
    /* -------------------------------------- */
    body.dark-mode {
        --page-bg: #1a202c;
        --text-color: #e2e8f0;
        --text-secondary-color: #a0aec0;
        --heading-color: #cbd5e0;
        --card-bg: #2d3748;
        --card-border: #4a5568;
        --shadow-color: rgba(0, 0, 0, 0.4);
        --hover-bg-light: #4a5568;

        --navbar-bg: #2d3748;
        --navbar-text: white;

        --primary-green: #38a169;
        --hover-green: #48bb78;

        --logout-red: #c53030;
        --logout-red-hover: #9b2c2c;
        --points-orange: #ed8936;

        --admin-blue: #4299e1;
        --admin-blue-hover: #63b3ed;
        --login-blue: #4299e1;
        --login-blue-hover: #3182ce;

        --input-bg: #4a5568;
        --input-border: #667085;
        --input-focus-border: #63b3ed;
        --input-focus-shadow: rgba(99, 179, 237, 0.25);
        --placeholder-color: #a0aec0;

        --table-header-bg: #4a5568;
        --table-row-even-bg: #2d3748;
        --table-hover-bg: #4a5568;
        --dark-mode-table-border-color: #667085;

        --status-success-bg: #2f855a;
        --status-success-color: #fff;
        --status-error-bg: #c53030;
        --status-error-color: #fff;
        --status-info-bg: #2b6cb0;
        --status-info-color: #fff;

        /* Side Menu Variables - Dark Mode */
        --side-menu-bg: #1a202c;
        --side-menu-text: #f1f1f1;
        --side-menu-border: #4a5568;
        --side-menu-hover-bg: #2d3748;
        --side-menu-header-bg: #2d3748;
        --side-menu-header-border: #4a5568;
    }

    /* -------------------------------------- */
    /* Base and Layout Styles */
    /* -------------------------------------- */
    body {
        margin: 0;
        font-family: 'Inter', sans-serif;
        background-color: var(--page-bg);
        color: var(--text-color);
        transition: background-color 0.3s ease, color 0.3s ease;
    }

    .navbar {
        background-color: var(--navbar-bg);
        padding: 12px 20px;
        display: flex;
        justify-content: space-between;
        align-items: center;
        color: var(--navbar-text);
        position: sticky;
        top: 0;
        z-index: 1000;
        width: 100%;
        font-size: 1em;
        box-shadow: 0 2px 5px var(--shadow-color);
    }

    .menu-toggle {
        display: none;
        font-size: 1.8em;
        cursor: pointer;
        color: var(--navbar-text);
        margin-right: 15px;
    }

    .navbar-brand-area {
        display: flex;
        flex-direction: column;
        align-items: flex-start;
        margin-right: 0;
    }

    .navbar .logo {
        font-size: 1.5em;
        font-weight: bold;
        color: var(--navbar-text);
        text-decoration: none;
        margin-bottom: 0;
        white-space: nowrap;
    }

    .navbar-links {
        display: flex;
        align-items: center;
        margin-right: auto;
        flex-wrap: wrap;
        overflow-x: visible;
        gap: 12px;
    }

    .navbar-links a {
        color: var(--navbar-text);
        text-decoration: none;
        padding: 7px 14px;
        border-radius: 4px;
        font-size: 0.95em;
        white-space: nowrap;
        transition: background-color 0.2s ease;
    }

    .navbar-links a:hover {
        background-color: var(--hover-green);
    }

    .navbar-user-info {
        display: flex;
        align-items: center;
        gap: 15px;
        margin-left: 15px;
    }

    .profile-link-container {
        display: flex;
        align-items: center;
        gap: 8px;
        text-decoration: none;
        color: var(--navbar-text);
        padding: 5px 10px;
        border-radius: 4px;
        transition: background-color 0.2s ease;
        cursor: pointer;
        white-space: nowrap;
    }

    .profile-link-container:hover {
        background-color: var(--hover-green);
    }

    .navbar-user-info img {
        width: 36px;
        height: 36px;
        border-radius: 50%;
        object-fit: cover;
        border: 2px solid var(--navbar-text);
    }

    .navbar-user-info span {
        font-weight: bold;
        font-size: 0.9em;
        white-space: nowrap;
    }

    .navbar-points {
        background-color: var(--points-orange);
        padding: 4px 10px;
        border-radius: 15px;
        font-size: 0.8em;
        color: var(--navbar-text);
        display: flex;
        align-items: center;
        gap: 4px;
        white-space: nowrap;
    }

    .navbar-logout {
        background-color: var(--logout-red);
        color: var(--navbar-text);
        border: none;
        padding: 8px 15px;
        border-radius: 4px;
        font-size: 0.9em;
        cursor: pointer;
        text-decoration: none;
        transition: background-color 0.2s ease;
        white-space: nowrap;
    }

    .navbar-logout:hover {
        background-color: var(--logout-red-hover);
    }

    .navbar-logout.login-btn {
        background-color: var(--login-blue);
    }

    .navbar-logout.login-btn:hover {
        background-color: var(--login-blue-hover);
    }

    .navbar-logout.admin-login-btn {
        background-color: var(--admin-blue);
    }

    .navbar-logout.admin-login-btn:hover {
        background-color: var(--admin-blue-hover);
    }

    .admin-link-btn {
        background-color: var(--admin-blue);
        color: var(--navbar-text);
        padding: 8px 15px;
        border-radius: 4px;
        font-size: 0.9em;
        text-decoration: none;
        transition: background-color 0.2s ease;
        display: flex;
        align-items: center;
        justify-content: center;
    }

    .admin-link-btn:hover {
        background-color: var(--admin-blue-hover);
    }

    .side-menu {
        height: 100%;
        width: 0;
        position: fixed;
        z-index: 1001;
        top: 0;
        left: 0;
        background-color: var(--side-menu-bg);
        box-shadow: 2px 0 5px var(--shadow-color);
        overflow-x: hidden;
        overflow-y: auto;
        transition: 0.5s;
        padding-top: 60px;
        display: flex;
        flex-direction: column;
    }

    .side-menu a {
        padding: 12px 20px;
        font-size: 1.2em;
        color: var(--side-menu-text) !important;
        font-weight: 600;
        border-bottom: 1px solid var(--side-menu-border);
        text-decoration: none;
        transition: background-color 0.2s ease, color 0.2s ease;
        display: block;
    }

    .side-menu a:hover {
        color: var(--primary-green) !important;
        background-color: var(--side-menu-hover-bg);
    }

    .side-menu .close-btn {
        position: absolute;
        top: 0;
        right: 20px;
        font-size: 2.5em;
        color: var(--side-menu-text);
        cursor: pointer;
        background: none;
        border: none;
        padding: 0;
        line-height: 1;
    }

    /* Mobile view for user info in side menu */
    .navbar-user-info.mobile-view {
        display: flex;
        flex-direction: column;
        align-items: center;
        padding: 20px;
        background-color: var(--side-menu-header-bg);
        border-bottom: 1px solid var(--side-menu-header-border);
        text-align: center;
    }

    .mobile-profile-link {
        display: flex;
        flex-direction: column;
        align-items: center;
        text-decoration: none;
        color: var(--side-menu-text);
        transition: background-color 0.2s ease;
        padding-bottom: 10px;
    }

    .mobile-profile-link:hover {
        background-color: var(--side-menu-hover-bg);
    }

    .navbar-user-info.mobile-view img {
        width: 70px;
        height: 70px;
        margin-bottom: 10px;
        border: 3px solid var(--side-menu-text);
    }

    .navbar-user-info.mobile-view span {
        font-size: 1.2em;
        color: var(--side-menu-text);
        margin-bottom: 8px;
    }

    .navbar-user-info.mobile-view .navbar-points {
        margin-top: 5px;
        font-size: 0.95em;
        padding: 5px 12px;
    }

    .side-menu .mobile-action-btn {
        display: block;
        width: calc(100% - 40px);
        margin: 15px auto 5px auto;
        padding: 12px 20px;
        border-radius: 6px;
        font-size: 1.1em;
        text-align: center;
        text-decoration: none;
        color: white;
        /* Buttons usually have white text */
        border: none;
        cursor: pointer;
        transition: background-color 0.2s ease;
        box-shadow: 0 2px 5px rgba(0, 0, 0, 0.2);
    }

    .side-menu .mobile-logout-btn {
        background-color: var(--logout-red);
    }

    .side-menu .mobile-logout-btn:hover {
        background-color: var(--logout-red-hover);
    }

    .side-menu .mobile-login-btn {
        background-color: var(--login-blue);
    }

    .side-menu .mobile-login-btn:hover {
        background-color: var(--login-blue-hover);
    }

    .side-menu .mobile-admin-login-btn {
        background-color: var(--admin-blue);
    }

    .side-menu .mobile-admin-login-btn:hover {
        background-color: var(--admin-blue-hover);
    }

    .side-menu .mobile-admin-link {
        display: flex;
        align-items: center;
        gap: 10px;
        padding: 12px 20px;
        font-size: 1.2em;
        color: var(--side-menu-text);
        border-bottom: 1px solid var(--side-menu-border);
        text-decoration: none;
        transition: background-color 0.2s ease, color 0.2s ease;
    }

    .side-menu .mobile-admin-link:hover {
        background-color: var(--side-menu-hover-bg);
        color: var(--primary-green);
    }

    /* Responsive adjustments */
    @media screen and (max-width: 768px) {
        .navbar {
            padding: 6px 10px;
            font-size: 0.75em;
        }

        .navbar .logo {
            font-size: 1.1em;
        }

        .navbar-links,
        .navbar-user-info {
            display: none;
        }

        .menu-toggle {
            display: block;
            font-size: 1.5em;
        }

        .navbar-brand-area {
            margin-right: 0;
        }

        .side-menu {
            padding-top: 20px;
        }
    }
</style>

<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0-beta3/css/all.min.css">

